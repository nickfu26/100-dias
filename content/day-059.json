{
  "$schema": "./schema.json",
  "day": 59,
  "level": 3,
  "title": { "en": "Lost passport, stolen phone", "es": "Me han robado el móvil" },
  "objectives": [
    "Say you've lost something or had something stolen",
    "Report a theft at the police station",
    "Know where to go for a lost passport",
    "Warn someone: ¡Cuidado!"
  ],
  "teach": [
    {
      "kind": "note",
      "md": "**Pickpockets (carteristas)** work the busiest places: Sol, the metro, Gran Vía, the Rastro. Keep your phone out of back pockets and off café tables, and wear a bag in front of you in crowds.\n\nIf something is stolen, report it at a **comisaría** (police station). You'll need the report (**la denuncia**) for insurance and for a new passport. Ask for the **SATE**, the police office for foreign tourists, which has interpreters."
    },
    { "kind": "phrase", "es": "Me han robado el móvil.", "en": "My phone has been stolen.", "note": "Literally 'They have stolen my phone from me'. Also: Me han robado la cartera (my wallet)." },
    { "kind": "phrase", "es": "He perdido el pasaporte.", "en": "I've lost my passport.", "note": "he perdido = I've lost. Spanish often says el pasaporte (the passport) where English says my passport." },
    { "kind": "phrase", "es": "¿Dónde está la comisaría? Quiero poner una denuncia.", "en": "Where's the police station? I want to report it.", "note": "poner una denuncia = to file a police report." },
    { "kind": "phrase", "es": "¿Dónde está la embajada de mi país?", "en": "Where's my country's embassy?", "note": "For a lost passport: report it at the comisaría first, then go to your embassy or consulate (el consulado) for an emergency passport. Look up the address before you travel." },
    { "kind": "phrase", "es": "¡Cuidado!", "en": "Watch out! Careful!", "note": "¡Cuidado con el móvil! = Careful with your phone! You'll also hear it in the metro: ¡Cuidado con los carteristas!" }
  ],
  "vocab": [
    { "id": "he-perdido", "es": "He perdido…", "en": "I've lost…", "pos": "phrase", "ipa": "e peɾˈðiðo", "note": "He perdido el pasaporte.", "tags": ["survival"] },
    { "id": "me-han-robado", "es": "Me han robado…", "en": "Someone has stolen my…", "pos": "phrase", "ipa": "me an roˈβaðo", "note": "Me han robado el móvil, la cartera.", "tags": ["survival"] },
    { "id": "cartera", "es": "la cartera", "en": "wallet", "pos": "noun", "gender": "f", "ipa": "kaɾˈteɾa", "tags": ["survival"] },
    { "id": "comisaria", "es": "la comisaría", "en": "police station", "pos": "noun", "gender": "f", "ipa": "komisaˈɾia", "tags": ["survival"] },
    { "id": "poner-una-denuncia", "es": "poner una denuncia", "en": "to file a police report", "pos": "phrase", "ipa": "poˈneɾ ˈuna ðeˈnunθja", "tags": ["survival"] },
    { "id": "embajada", "es": "la embajada de mi país", "en": "my country's embassy", "pos": "phrase", "ipa": "la embaˈxaða ðe mi paˈis", "note": "el consulado = consulate.", "tags": ["survival"] },
    { "id": "carterista", "es": "el carterista", "en": "pickpocket", "pos": "noun", "gender": "mf", "ipa": "kaɾteˈɾista", "note": "From la cartera, wallet.", "tags": ["survival", "madrid"] },
    { "id": "cuidado", "es": "¡Cuidado!", "en": "Watch out! Careful!", "pos": "interj", "ipa": "kwiˈðaðo", "note": "¡Cuidado con…! = Careful with…!", "tags": ["survival"] }
  ],
