{
  "$schema": "./schema.json",
  "day": 31,
  "level": 2,
  "title": { "en": "Can I…?", "es": "¿Puedo…?" },
  "objectives": [
    "Ask permission with ¿Puedo…? and ¿Se puede…?",
    "Say what you need with necesito",
    "Use verb + infinitive: puedo ir, necesito ir",
    "Know when to use usted instead of tú"
  ],
  "teach": [
    {
      "kind": "note",
      "md": "**poder** = *can, to be able to*. Like *querer*, it changes its stem, here **o → ue**: **puedo, puedes, puede**.\n\nAfter *poder*, the next verb stays in the infinitive (the dictionary form), just like English *can go*: **¿Puedo ir?**"
    },
    {
      "kind": "conjugation",
      "verb": "poder",
      "verbEn": "can, to be able to",
      "tense": "present",
      "forms": {
        "yo": "puedo",
        "tu": "puedes",
        "el": "puede",
        "nosotros": "podemos",
        "vosotros": "podéis",
        "ellos": "pueden"
      }
    },
    { "kind": "phrase", "es": "¿Puedo ir al baño?", "en": "Can I go to the toilet?", "note": "puedo + infinitive. You already know ¿Puedes repetirlo? from day 6: that's puedes + repetir." },
    { "kind": "phrase", "es": "¿Se puede?", "en": "May I? / Is it allowed?", "note": "Said at a half-open door, or pointing at a free chair. ¿Se puede ir en metro? = Can you get there by metro?" },
    { "kind": "phrase", "es": "Necesito un cajero.", "en": "I need a cash machine.", "note": "necesito + a noun, or + an infinitive: Necesito ir a la farmacia. Necesitar is regular: necesito, necesitas, necesita." },
    {
      "kind": "note",
      "md": "**usted** is the polite *you*. It uses the **he/she** form of the verb: *¿Usted **es** de Madrid?*, *¿**Puede** repetir?*, *¿**Tiene** mesa?*\n\nSpain uses *tú* much more than Latin America does. Waiters, shop staff and people your age will usually say *tú* to you. Use **usted** with older people, officials, police and in formal places, or whenever you're unsure. Nobody minds being given *usted*."
    }
  ],
  "vocab": [
    { "id": "poder", "es": "poder", "en": "can, to be able to", "pos": "verb", "ipa": "poˈðeɾ" },
    { "id": "puedo", "es": "puedo", "en": "I can", "pos": "verb", "ipa": "ˈpweðo", "note": "¿Puedo…? = Can I…?", "tags": ["survival"] },
    { "id": "puede", "es": "puede", "en": "he / she can; you can (usted)", "pos": "verb", "ipa": "ˈpweðe", "note": "¿Puede repetir? = Could you repeat that? (polite)" },
    { "id": "se-puede", "es": "¿Se puede…?", "en": "Is it OK to…? Can one…?", "pos": "phrase", "ipa": "se ˈpweðe", "note": "On its own, ¿Se puede? = May I come in?", "tags": ["survival"] },
    { "id": "necesito", "es": "necesito", "en": "I need", "pos": "verb", "ipa": "neθeˈsito", "note": "From necesitar (regular).", "tags": ["survival"] },
    { "id": "usted", "es": "usted", "en": "you (formal)", "pos": "pron", "ipa": "usˈteð", "note": "Uses the he/she verb form. Written Ud. on signs." }
  ],
  "exercises": [
