    { "id": "d033-05", "type": "match-pairs", "pairs": [["trabajo", "I work"], ["trabajas", "you work"], ["trabaja", "she works"], ["trabajamos", "we work"], ["trabajan", "they work"]], "prompt": "Same endings as hablar.", "vocab": ["trabajar"] },
    { "id": "d033-06", "type": "fill-blank", "es": "Yo {{hablo}} un poco de español.", "en": "I speak a little Spanish.", "options": ["hablo", "habla", "hablas"], "vocab": ["hablar", "espanol"] },
    { "id": "d033-07", "type": "fill-blank", "es": "Perdón, ¿{{habla}} inglés?", "en": "Excuse me, do you speak English? (usted)", "options": ["habla", "hablas", "hablo"], "vocab": ["hablas-ingles", "perdon"] },
    { "id": "d033-08", "type": "fill-blank", "es": "{{Busco}} la estación de Atocha.", "en": "I'm looking for Atocha station.", "options": ["Busco", "Busca", "Buscar"], "vocab": ["buscar", "estacion"] },
    { "id": "d033-09", "type": "fill-blank", "es": "¿Qué {{tomas}}? Una caña.", "en": "What are you having? A beer.", "options": ["tomas", "tomo", "toman"], "vocab": ["tomar", "cana"] },
    { "id": "d033-10", "type": "fill-blank", "es": "Hoy {{pago}} yo.", "en": "Today I'll pay.", "options": ["pago", "paga", "pagas"], "vocab": ["pagar", "hoy", "yo"] },
    { "id": "d033-11", "type": "fill-blank", "es": "Nosotros {{llegamos}} el miércoles.", "en": "We arrive on Wednesday.", "options": ["llegamos", "llegan", "llego"], "vocab": ["llegar", "miercoles"] },
    { "id": "d033-12", "type": "listen-choose", "prompt": "When does she arrive?", "audio": "Llego a Madrid el trece de enero.", "optionsLang": "en", "options": ["13 January", "30 January", "3 January"], "answer": 0, "vocab": ["llegar", "fecha"] },
    { "id": "d033-13", "type": "listen-choose", "prompt": "Who is paying?", "audio": "No, no. Pago yo.", "optionsLang": "en", "options": ["The speaker", "The other person", "They split it"], "answer": 0, "vocab": ["pagar"] },
    { "id": "d033-14", "type": "listen-choose", "prompt": "What is he looking for?", "audio": "Busco una farmacia. ¿Está cerca?", "optionsLang": "en", "options": ["A pharmacy", "A supermarket", "The station"], "answer": 0, "vocab": ["buscar", "farmacia"] },
    { "id": "d033-15", "type": "dictation", "es": "hablo", "hint": "I speak (silent h)", "vocab": ["hablar"] },
    { "id": "d033-16", "type": "dictation", "es": "pagar", "hint": "to pay", "vocab": ["pagar"] },
    { "id": "d033-17", "type": "dictation", "es": "trabajo", "hint": "I work", "vocab": ["trabajar"] },
    { "id": "d033-18", "type": "build-sentence", "es": "¿Hablas inglés? Hablo un poco de español.", "en": "Do you speak English? I speak a little Spanish.", "distractors": ["habla", "eres"], "vocab": ["hablas-ingles", "hablar", "espanol"] },
    { "id": "d033-19", "type": "build-sentence", "es": "Busco el metro. ¿Está lejos?", "en": "I'm looking for the metro. Is it far?", "distractors": ["es", "busca"], "vocab": ["buscar", "metro", "lejos"] },
    { "id": "d033-20", "type": "build-sentence", "direction": "audio-to-es", "es": "Trabajo en Estados Unidos, pero hablo español.", "en": "I work in the United States, but I speak Spanish.", "distractors": ["trabaja"], "vocab": ["trabajar", "hablar", "pero"] },
