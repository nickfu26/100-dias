    { "id": "d031-02", "type": "listen-choose", "audio": "necesito", "options": ["necesito", "necesita", "necesitas"], "answer": 0, "vocab": ["necesito"] },
    { "id": "d031-03", "type": "listen-choose", "audio": "usted", "options": ["usted", "tú", "yo"], "answer": 0, "vocab": ["usted"] },
    { "id": "d031-04", "type": "match-pairs", "pairs": [["puedo", "I can"], ["puede", "she can"], ["necesito", "I need"], ["usted", "you (formal)"], ["¿Se puede?", "May I?"]], "vocab": ["puedo", "puede", "necesito", "usted", "se-puede"] },
    { "id": "d031-05", "type": "fill-blank", "es": "¿{{Puedo}} ir al baño?", "en": "Can I go to the toilet?", "options": ["Puedo", "Puede", "Necesito"], "vocab": ["puedo", "aseos"] },
    { "id": "d031-06", "type": "fill-blank", "es": "{{Necesito}} un cajero.", "en": "I need a cash machine.", "options": ["Necesito", "Puedo", "Voy"], "vocab": ["necesito", "cajero"] },
    { "id": "d031-07", "type": "fill-blank", "es": "Necesito {{ir}} a la farmacia.", "en": "I need to go to the pharmacy.", "options": ["ir", "voy", "va"], "prompt": "After necesito, use the infinitive.", "vocab": ["necesito", "ir", "farmacia"] },
    { "id": "d031-08", "type": "fill-blank", "es": "Perdón, ¿{{puede}} repetir?", "en": "Sorry, could you repeat that?", "options": ["puede", "puedo", "puedes"], "prompt": "To an older stranger (usted).", "vocab": ["puede", "perdon"] },
    { "id": "d031-09", "type": "fill-blank", "es": "¿Usted {{es}} de Madrid?", "en": "Are you from Madrid? (formal)", "options": ["es", "eres", "soy"], "prompt": "usted takes the he/she form.", "vocab": ["usted", "es-is"] },
    { "id": "d031-10", "type": "fill-blank", "es": "¿Se {{puede}} ir en metro?", "en": "Can you get there by metro?", "options": ["puede", "puedo", "pueden"], "vocab": ["se-puede", "metro"] },
    { "id": "d031-11", "type": "listen-choose", "prompt": "What does he need?", "audio": "Necesito ir al aeropuerto.", "optionsLang": "en", "options": ["To go to the airport", "To go to the station", "A ticket to the airport"], "answer": 0, "vocab": ["necesito", "aeropuerto"] },
    { "id": "d031-12", "type": "listen-choose", "prompt": "What is she asking?", "audio": "¿Puedo ir ahora?", "optionsLang": "en", "options": ["If she can go now", "If she can go tomorrow", "Where she should go"], "answer": 0, "vocab": ["puedo", "ir", "ahora"] },
    { "id": "d031-13", "type": "listen-choose", "prompt": "tú or usted?", "audio": "¿Tiene usted el horario?", "optionsLang": "en", "options": ["usted (formal)", "tú (informal)"], "answer": 0, "vocab": ["usted", "horario"] },
    { "id": "d031-14", "type": "listen-choose", "prompt": "tú or usted?", "audio": "¿Quieres un café?", "optionsLang": "en", "options": ["tú (informal)", "usted (formal)"], "answer": 0, "vocab": ["quieres-q"] },
    { "id": "d031-15", "type": "dictation", "es": "puedo", "hint": "I can", "vocab": ["puedo"] },
    { "id": "d031-16", "type": "dictation", "es": "necesito", "hint": "I need (c before i = θ)", "vocab": ["necesito"] },
    { "id": "d031-17", "type": "dictation", "es": "usted", "hint": "you (formal)", "vocab": ["usted"] },
    { "id": "d031-18", "type": "build-sentence", "es": "Necesito ir a la farmacia.", "en": "I need to go to the pharmacy.", "distractors": ["voy", "al"], "vocab": ["necesito", "ir", "farmacia"] },
    { "id": "d031-19", "type": "build-sentence", "es": "¿Puedo ir en metro al museo?", "en": "Can I go to the museum by metro?", "distractors": ["puede", "el"], "vocab": ["puedo", "ir", "metro", "museo"] },
    { "id": "d031-20", "type": "build-sentence", "direction": "audio-to-es", "es": "Perdón, ¿usted es de Madrid?", "en": "Excuse me, are you from Madrid?", "distractors": ["eres"], "vocab": ["perdon", "usted", "es-is"] },
    { "id": "d031-21", "type": "repeat", "es": "Perdón, ¿puede repetir, por favor?", "en": "Sorry, could you repeat that, please?", "vocab": ["puede", "perdon"] },
    { "id": "d031-22", "type": "shadow", "es": "¿Se puede?", "en": "May I?", "listenFor": "ue in puede as one quick glide, PWE-ðe, with a soft d.", "vocab": ["se-puede"] },
    { "id": "d031-23", "type": "listen-choose", "prompt": "Review: what does he think of Madrid?", "audio": "Me encanta Madrid, pero no me gusta nada el frío.", "optionsLang": "en", "options": ["Loves Madrid, hates the cold", "Likes the cold, not Madrid", "Loves both"], "answer": 0, "vocab": ["me-encanta", "no-me-gusta-nada"] },
    { "id": "d031-24", "type": "repeat", "prompt": "Review: say it aloud.", "es": "Hace frío. Necesito un abrigo y unos guantes.", "en": "It's cold. I need a coat and some gloves.", "vocab": ["hace-frio", "necesito", "abrigo", "guantes"] }
  ]
}
