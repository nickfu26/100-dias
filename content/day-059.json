    { "id": "d059-20", "type": "repeat", "prompt": "At hotel reception:", "es": "Hola. Me han robado el móvil. ¿Qué hago?", "en": "Hi. My phone has been stolen. What should I do?", "vocab": ["me-han-robado", "movil", "que-hago"] },
    { "id": "d059-21", "type": "repeat", "prompt": "At hotel reception:", "es": "Perdone, he perdido el pasaporte. ¿Me puede ayudar?", "en": "Excuse me, I've lost my passport. Can you help me?", "vocab": ["perdone", "he-perdido", "me-puede-ayudar"] },
    { "id": "d059-22", "type": "shadow", "es": "Me han robado la cartera.", "en": "My wallet has been stolen.", "listenFor": "han robado runs together: a-rro-BA-do. The r at the start of a word is rolled, like rr.", "vocab": ["me-han-robado", "cartera"] },
