{
  "$schema": "./schema.json",
  "checkpoint": 3,
  "level": 3,
  "title": { "en": "Level 3 test: situations", "es": "Prueba del nivel tres" },
  "passMark": 0.8,
  "exercises": [
    { "id": "c3-01", "type": "match-pairs", "prompt": "At the bar.", "pairs": [["¿Qué te pongo?", "What can I get you?"], ["Ponme…", "I'll have…"], ["Otra, por favor.", "Another one, please."], ["Nada más.", "That's all."], ["para compartir", "to share"], ["media ración", "half plate"]], "vocab": ["que-te-pongo", "ponme", "otra-por-favor", "nada-mas", "para-compartir", "media-racion"] },
    { "id": "c3-02", "type": "listen-choose", "prompt": "What is he doing?", "audio": "Para mí, una caña. ¿Y para ti?", "optionsLang": "en", "options": ["Ordering a beer and asking what his friend wants", "Ordering two beers", "Asking for the bill"], "answer": 0, "vocab": ["para-mi", "cana", "y-para-ti"] },
    { "id": "c3-03", "type": "fill-blank", "prompt": "Point at the board.", "es": "Perdón, ¿qué {{lleva}}?", "en": "Excuse me, what's in it?", "options": ["lleva", "llega", "es"], "vocab": ["que-lleva"] },
    { "id": "c3-04", "type": "fill-blank", "es": "¿Cuánto te {{debo}}?", "en": "How much do I owe you?", "options": ["debo", "cobras", "cuesta"], "vocab": ["cuanto-te-debo"] },
    { "id": "c3-05", "type": "listen-choose", "prompt": "How will he pay?", "audio": "¿Con tarjeta o en efectivo? — Con tarjeta.", "optionsLang": "en", "options": ["By card", "In cash", "By phone"], "answer": 0, "vocab": ["con-tarjeta", "en-efectivo"] },
    { "id": "c3-06", "type": "listen-choose", "prompt": "What does the waiter ask?", "audio": "Buenas noches. ¿Cuántos sois? ¿Tenéis reserva?", "optionsLang": "en", "options": ["How many, and do you have a booking?", "Inside or outside?", "What time do you want to eat?"], "answer": 0, "vocab": ["cuantos-sois", "tengo-una-reserva"] },
    { "id": "c3-07", "type": "fill-blank", "es": "Una mesa {{para}} dos, en la terraza.", "en": "A table for two, on the terrace.", "options": ["para", "de", "con"], "vocab": ["mesa-para-dos", "terraza"] },
    { "id": "c3-08", "type": "repeat", "prompt": "You booked a table:", "es": "Tengo una reserva a nombre de Smith.", "en": "I have a booking under the name Smith.", "vocab": ["tengo-una-reserva"] },
    { "id": "c3-09", "type": "listen-choose", "prompt": "What's included?", "audio": "El menú del día cuesta quince euros, con bebida y postre.", "optionsLang": "en", "options": ["€15, with a drink and dessert", "€50, with a drink", "€15, drink extra"], "answer": 0, "vocab": ["menu-del-dia", "quince", "postre"] },
    { "id": "c3-10", "type": "fill-blank", "es": "¿Nos {{trae}} más pan, por favor?", "en": "Could you bring us more bread, please?", "options": ["trae", "tiene", "lleva"], "vocab": ["nos-trae", "pan"] },
    { "id": "c3-11", "type": "listen-choose", "prompt": "Where's the bank?", "audio": "Coge la segunda calle a la derecha. El banco está enfrente del hotel.", "optionsLang": "en", "options": ["Second right; opposite the hotel", "Second left; next to the hotel", "First right; at the end of the street"], "answer": 0, "vocab": ["primera-segunda", "a-la-derecha", "enfrente-de", "banco"] },
    { "id": "c3-12", "type": "match-pairs", "prompt": "Directions.", "pairs": [["todo recto", "straight on"], ["a la izquierda", "on the left"], ["al lado de", "next to"], ["enfrente de", "opposite"], ["¿Está lejos?", "Is it far?"], ["andando", "on foot"]], "vocab": ["todo-recto", "a-la-izquierda", "al-lado-de", "enfrente-de", "esta-lejos", "andando"] },
    { "id": "c3-13", "type": "fill-blank", "es": "Perdone, ¿{{por}} dónde se va a Sol?", "en": "Excuse me, which way is it to Sol?", "options": ["por", "para", "de"], "vocab": ["perdone", "por-donde-se-va"] },
    { "id": "c3-14", "type": "listen-choose", "prompt": "How far is it?", "audio": "Está a diez minutos andando.", "optionsLang": "en", "options": ["Ten minutes' walk", "Two minutes' walk", "Ten minutes by metro"], "answer": 0, "vocab": ["a-minutos", "andando", "diez"] },
    { "id": "c3-15", "type": "fill-blank", "prompt": "You have a big bag.", "es": "¿Dónde está el {{guardarropa}}?", "en": "Where's the cloakroom?", "options": ["guardarropa", "audioguía", "cola"], "vocab": ["guardarropa", "donde-esta"] },
    { "id": "c3-16", "type": "listen-choose", "prompt": "What does she tell the assistant?", "audio": "¿Te puedo ayudar? — No, gracias. Solo estoy mirando.", "optionsLang": "en", "options": ["She's just looking", "She wants another size", "She wants to pay"], "answer": 0, "vocab": ["te-puedo-ayudar", "solo-estoy-mirando"] },
    { "id": "c3-17", "type": "fill-blank", "es": "¿Puedo {{probármelos}}?", "en": "Can I try them on? (los pantalones)", "options": ["probármelos", "probármelo", "probármela"], "vocab": ["puedo-probarmelo", "pantalones"] },
    { "id": "c3-18", "type": "listen-choose", "prompt": "What does the shop need?", "audio": "Para el tax free, ¿me deja su pasaporte?", "optionsLang": "en", "options": ["Your passport, for the tax-free form", "Your boarding pass", "Your receipt"], "answer": 0, "vocab": ["me-hace-el-tax-free", "me-deja-su-pasaporte"] },
    { "id": "c3-19", "type": "dictation", "es": "Trato hecho.", "hint": "Deal.", "vocab": ["trato-hecho"] },
    { "id": "c3-20", "type": "listen-choose", "prompt": "Where's the room?", "audio": "Su habitación está en la planta baja, al lado del ascensor.", "optionsLang": "en", "options": ["Ground floor, next to the lift", "First floor, next to the lift", "Ground floor, opposite the lift"], "answer": 0, "vocab": ["habitacion", "planta", "ascensor", "al-lado-de"] },
    { "id": "c3-21", "type": "fill-blank", "es": "¿Cuál es la {{contraseña}} del wifi?", "en": "What's the wifi password?", "options": ["contraseña", "cuenta", "llave"], "vocab": ["contrasena-wifi"] },
    { "id": "c3-22", "type": "build-sentence", "es": "Tengo que estar en el aeropuerto a las dos.", "en": "I have to be at the airport at two.", "distractors": ["soy", "de"], "vocab": ["tengo-que", "aeropuerto", "a-las"] },
    { "id": "c3-23", "type": "listen-choose", "prompt": "What's the route?", "audio": "Haces transbordo en Sol y coges la línea tres, dirección Villaverde Alto.", "optionsLang": "en", "options": ["Change at Sol to line 3, towards Villaverde Alto", "Line 3 straight to Sol", "Change at Villaverde Alto"], "answer": 0, "vocab": ["hacer-transbordo", "linea", "direccion"] },
    { "id": "c3-24", "type": "fill-blank", "es": "Un billete de ida y {{vuelta}}, por favor.", "en": "A return ticket, please.", "options": ["vuelta", "ida", "viaje"], "vocab": ["ida-y-vuelta"] },
    { "id": "c3-25", "type": "listen-choose", "prompt": "Which track?", "audio": "El tren con destino Segovia efectuará su salida por la vía nueve.", "optionsLang": "en", "options": ["Track 9", "Delayed 9 minutes", "Track 19"], "answer": 0, "vocab": ["con-destino", "efectuara-su-salida", "nueve"] },
    { "id": "c3-26", "type": "listen-choose", "prompt": "What does the officer ask?", "audio": "¿Motivo del viaje?", "optionsLang": "en", "options": ["The reason for your trip", "Your flight number", "Where you're staying"], "answer": 0, "vocab": ["motivo-del-viaje"] },
    { "id": "c3-27", "type": "fill-blank", "es": "¿Dónde está la {{recogida}} de equipajes?", "en": "Where's baggage claim?", "options": ["recogida", "salida", "terminal"], "vocab": ["recogida-de-equipajes"] },
    { "id": "c3-28", "type": "dictation", "es": "la tarjeta de embarque", "hint": "boarding pass", "vocab": ["tarjeta-de-embarque"] },
    { "id": "c3-29", "type": "repeat", "prompt": "At the pharmacy:", "es": "¿Tiene algo para el dolor de cabeza?", "en": "Do you have something for a headache?", "vocab": ["tiene-algo-para", "dolor-de-cabeza"] },
    { "id": "c3-30", "type": "repeat", "prompt": "At the police station:", "es": "He perdido el pasaporte. Quiero poner una denuncia.", "en": "I've lost my passport. I want to file a report.", "vocab": ["he-perdido", "poner-una-denuncia"] }
  ]
}
