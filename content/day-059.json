{
  "$schema": "./schema.json",
  "day": 59,
  "level": 3,
  "title": { "en": "Lost passport, stolen phone", "es": "Me han robado el móvil" },
  "objectives": [
    "Say you've lost something or had something stolen",
    "Ask the hotel reception what to do",
    "Understand where they send you",
    "Warn someone: ¡Cuidado!"
  ],
  "teach": [
    {
      "kind": "note",
      "md": "**Pickpockets (carteristas)** work the busiest places: Sol, the metro, Gran Vía, the Rastro. Keep your phone out of back pockets and off café tables, and wear a bag in front of you in crowds.\n\nIf you lose something or it's stolen, **go to your hotel reception** and say what happened. They deal with this all the time and will tell you where to go, often a **comisaría** (police station)."
    },
    { "kind": "phrase", "es": "Me han robado el móvil.", "en": "My phone has been stolen.", "note": "Literally 'They have stolen my phone from me'. Also: Me han robado la cartera (my wallet)." },
    { "kind": "phrase", "es": "He perdido el pasaporte.", "en": "I've lost my passport.", "note": "he perdido = I've lost. Spanish often says el pasaporte (the passport) where English says my passport. Also: He perdido la cartera." },
    { "kind": "phrase", "es": "Perdone, he perdido la cartera. ¿Qué hago?", "en": "Excuse me, I've lost my wallet. What should I do?", "note": "Say it at la recepción (reception). ¿Qué hago? = What do I do? Listen for where they send you: Tiene que ir a la comisaría = You have to go to the police station." },
    { "kind": "phrase", "es": "¡Cuidado!", "en": "Watch out! Careful!", "note": "¡Cuidado con el móvil! = Careful with your phone! You'll also hear it in the metro: ¡Cuidado con los carteristas!" }
  ],
  "vocab": [
    { "id": "he-perdido", "es": "He perdido…", "en": "I've lost…", "pos": "phrase", "ipa": "e peɾˈðiðo", "note": "He perdido el pasaporte.", "tags": ["survival"] },
    { "id": "me-han-robado", "es": "Me han robado…", "en": "Someone has stolen my…", "pos": "phrase", "ipa": "me an roˈβaðo", "note": "Me han robado el móvil, la cartera.", "tags": ["survival"] },
    { "id": "cartera", "es": "la cartera", "en": "wallet", "pos": "noun", "gender": "f", "ipa": "kaɾˈteɾa", "tags": ["survival"] },
    { "id": "recepcion", "es": "la recepción", "en": "reception (hotel)", "pos": "noun", "gender": "f", "ipa": "reθepˈθjon", "note": "In Spain both c's are a th sound: re-thep-THYON.", "tags": ["survival", "hotel"] },
    { "id": "que-hago", "es": "¿Qué hago?", "en": "What do I do? What should I do?", "pos": "phrase", "ipa": "ke ˈaɣo", "note": "The h is silent: ke-A-go.", "tags": ["survival"] },
    { "id": "comisaria", "es": "la comisaría", "en": "police station", "pos": "noun", "gender": "f", "ipa": "komisaˈɾia", "note": "Mostly to recognise: Tiene que ir a la comisaría.", "tags": ["survival"] },
    { "id": "carterista", "es": "el carterista", "en": "pickpocket", "pos": "noun", "gender": "mf", "ipa": "kaɾteˈɾista", "note": "From la cartera, wallet.", "tags": ["survival", "madrid"] },
    { "id": "cuidado", "es": "¡Cuidado!", "en": "Watch out! Careful!", "pos": "interj", "ipa": "kwiˈðaðo", "note": "¡Cuidado con…! = Careful with…!", "tags": ["survival"] }
  ],
