    { "id": "d019-02", "type": "listen-choose", "audio": "tienes", "options": ["tiene", "tengo", "tienes"], "answer": 2, "vocab": ["tienes"] },
    { "id": "d019-03", "type": "listen-choose", "audio": "tengo sed", "options": ["tengo sed", "tengo seis", "tengo frío"], "answer": 0, "vocab": ["tengo-sed"] },
    { "id": "d019-04", "type": "match-pairs", "pairs": [["tengo hambre", "I'm hungry"], ["tengo sed", "I'm thirsty"], ["tengo frío", "I'm cold"], ["tengo calor", "I'm hot"]], "vocab": ["tengo-hambre", "tengo-sed", "tengo-frio", "tengo-calor"] },
    { "id": "d019-05", "type": "match-pairs", "pairs": [["tengo", "I have"], ["tienes", "you have"], ["tiene", "she has"], ["quiero", "I want"], ["quieres", "you want"]], "prompt": "tener or querer?", "vocab": ["tengo", "tienes", "tiene", "quiero", "quieres"] },
    { "id": "d019-06", "type": "fill-blank", "es": "Yo {{tengo}} un perro.", "en": "I have a dog.", "options": ["tengo", "tienes", "tiene"], "vocab": ["tengo", "yo", "perro"] },
    { "id": "d019-07", "type": "fill-blank", "es": "¿{{Tienes}} el móvil?", "en": "Have you got your phone?", "options": ["Tienes", "Tengo", "Tiene"], "vocab": ["tienes-q", "movil"] },
    { "id": "d019-08", "type": "fill-blank", "es": "Perdón, ¿{{tiene}} pan?", "en": "Excuse me, do you have bread?", "options": ["tiene", "tienes", "tengo"], "prompt": "You're asking a waiter (usted).", "vocab": ["tienes-q", "pan", "perdon"] },
    { "id": "d019-09", "type": "fill-blank", "es": "Tengo {{frío}}. Un café, por favor.", "en": "I'm cold. A coffee, please.", "options": ["frío", "calor", "sed"], "vocab": ["tengo-frio", "cafe"] },
    { "id": "d019-10", "type": "fill-blank", "es": "Tengo {{hambre}}. ¿Hay tapas?", "en": "I'm hungry. Are there tapas?", "options": ["hambre", "sed", "calor"], "vocab": ["tengo-hambre", "hay-q", "tapa"] },
    { "id": "d019-11", "type": "fill-blank", "es": "Ana {{tiene}} un gato.", "en": "Ana has a cat.", "options": ["tiene", "tienes", "tengo"], "vocab": ["tiene", "gato"] },
    { "id": "d019-12", "type": "listen-choose", "prompt": "How does he feel?", "audio": "Tengo mucha sed.", "optionsLang": "en", "options": ["Very thirsty", "Very hungry", "Very cold"], "answer": 0, "vocab": ["tengo-sed", "mucho"] },
    { "id": "d019-13", "type": "listen-choose", "prompt": "What is she asking the waiter?", "audio": "¿Tiene vino blanco?", "optionsLang": "en", "options": ["Do you have white wine?", "Do you want white wine?", "Is there red wine?"], "answer": 0, "vocab": ["tienes-q", "vino-blanco"] },
    { "id": "d019-14", "type": "listen-choose", "prompt": "Why does he want a drink?", "audio": "Tengo calor. Quiero agua.", "optionsLang": "en", "options": ["He's hot", "He's cold", "He's hungry"], "answer": 0, "vocab": ["tengo-calor", "quiero", "agua"] },
    { "id": "d019-15", "type": "dictation", "es": "tengo", "hint": "I have", "vocab": ["tengo"] },
    { "id": "d019-16", "type": "dictation", "es": "tengo hambre", "hint": "I'm hungry (silent h)", "vocab": ["tengo-hambre"] },
    { "id": "d019-17", "type": "dictation", "es": "¿Tienes agua?", "hint": "Do you have water?", "vocab": ["tienes-q", "agua"] },
    { "id": "d019-18", "type": "build-sentence", "es": "Tengo mucho frío.", "en": "I'm really cold.", "distractors": ["estoy", "calor"], "vocab": ["tengo-frio", "mucho"] },
    { "id": "d019-19", "type": "build-sentence", "es": "¿Tiene una botella de agua?", "en": "Do you have a bottle of water?", "distractors": ["tienes", "vaso"], "vocab": ["tienes-q", "botella", "agua"] },
    { "id": "d019-20", "type": "build-sentence", "direction": "audio-to-es", "es": "Tengo hambre y quiero un bocadillo.", "en": "I'm hungry and I want a sandwich.", "distractors": ["sed"], "vocab": ["tengo-hambre", "quiero", "bocadillo"] },
    { "id": "d019-21", "type": "repeat", "es": "Tengo hambre. ¿Tiene croquetas?", "en": "I'm hungry. Do you have croquettes?", "vocab": ["tengo-hambre", "tienes-q", "croquetas"] },
    { "id": "d019-22", "type": "shadow", "es": "Tengo mucho frío.", "en": "I'm really cold.", "listenFor": "ng in tengo said like in English 'finger', and the tapped r in frío.", "vocab": ["tengo-frio"] },
    { "id": "d019-23", "type": "listen-choose", "prompt": "Review: how much is it?", "audio": "Son setenta con cincuenta.", "optionsLang": "en", "options": ["€70.50", "€60.50", "€17.50"], "answer": 0, "vocab": ["son-con", "setenta", "cincuenta"] },
    { "id": "d019-24", "type": "repeat", "prompt": "Review: say it aloud.", "es": "¿Cuánto cuesta el cocido madrileño?", "en": "How much is the cocido madrileño?", "vocab": ["cuesta", "cocido"] }
  ]
}
