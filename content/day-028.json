    { "id": "d028-03", "type": "listen-choose", "audio": "pequeña", "options": ["pequeño", "pequeña", "grande"], "answer": 1, "vocab": ["pequeno"] },
    { "id": "d028-04", "type": "match-pairs", "pairs": [["negro", "black"], ["blanco", "white"], ["rojo", "red"], ["azul", "blue"], ["verde", "green"]], "vocab": ["negro", "blanco", "rojo", "azul", "verde"] },
    { "id": "d028-05", "type": "match-pairs", "pairs": [["gris", "grey"], ["marrón", "brown"], ["grande", "big"], ["pequeño", "small"]], "vocab": ["gris", "marron", "grande", "pequeno"] },
