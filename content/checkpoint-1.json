{
  "$schema": "./schema.json",
  "checkpoint": 1,
  "level": 1,
  "title": { "en": "Level 1 test: sounds and letters", "es": "Prueba del nivel uno" },
  "passMark": 0.8,
  "exercises": [
    { "id": "c1-01", "type": "listen-choose", "prompt": "Vowels: which word do you hear?", "audio": "mesa", "options": ["masa", "mesa", "misa"], "answer": 1, "vocab": ["mesa"] },
    { "id": "c1-02", "type": "listen-choose", "prompt": "Stress: which word do you hear?", "audio": "papá", "options": ["papa", "papá"], "answer": 1, "vocab": [] },
    { "id": "c1-03", "type": "match-pairs", "pairs": [["hola", "hello"], ["adiós", "goodbye"], ["buenos días", "good morning"], ["¿Qué tal?", "How's it going?"], ["hasta luego", "see you later"], ["buenas tardes", "good afternoon"]], "vocab": ["hola", "adios", "buenos-dias", "que-tal", "hasta-luego", "buenas-tardes"] },
    { "id": "c1-04", "type": "listen-choose", "prompt": "s or θ: which word do you hear?", "audio": "caza", "options": ["casa", "caza"], "answer": 1, "vocab": ["casa"] },
    { "id": "c1-05", "type": "fill-blank", "es": "—¿Qué tal? —Muy {{bien}}, ¿y tú?", "en": "How's it going? — Very well, and you?", "options": ["bien", "vale", "mucho"], "vocab": ["que-tal", "muy", "bien", "y-tu", "tu-you"] },
    { "id": "c1-06", "type": "match-pairs", "pairs": [["por favor", "please"], ["gracias", "thank you"], ["de nada", "you're welcome"], ["lo siento", "I'm sorry"], ["perdón", "sorry / excuse me"], ["buenas noches", "good night"]], "vocab": ["por-favor", "gracias", "de-nada", "lo-siento", "perdon", "buenas-noches"] },
    { "id": "c1-07", "type": "listen-choose", "prompt": "j or soft g: which word do you hear?", "audio": "hijo", "options": ["hijo", "higo"], "answer": 0, "vocab": ["hijo"] },
    { "id": "c1-08", "type": "listen-choose", "prompt": "One r or two: which word do you hear?", "audio": "perro", "options": ["pero", "perro"], "answer": 1, "vocab": ["pero", "perro"] },
    { "id": "c1-09", "type": "match-pairs", "pairs": [["no entiendo", "I don't understand"], ["¿Puedes repetirlo?", "Can you repeat that?"], ["más despacio", "slower"], ["¿Cómo se dice…?", "How do you say…?"], ["¿Cómo se escribe?", "How do you spell it?"]], "vocab": ["no-entiendo", "puedes-repetirlo", "mas-despacio", "como-se-dice", "como-se-escribe"] },
    { "id": "c1-10", "type": "listen-choose", "audio": "el centro de la ciudad", "optionsLang": "en", "options": ["the city centre", "the city square", "the city street"], "answer": 0, "vocab": ["centro", "ciudad"] },
    { "id": "c1-11", "type": "build-sentence", "es": "Me llamo Carmen. ¿Cómo te llamas?", "en": "My name is Carmen. What's your name?", "distractors": ["llamáis"], "vocab": ["me-llamo", "como-te-llamas"] },
    { "id": "c1-12", "type": "match-pairs", "pairs": [["el ordenador", "the computer"], ["el móvil", "the mobile phone"], ["el coche", "the car"], ["el autobús", "the bus"], ["el hotel", "the hotel"]], "vocab": ["ordenador", "movil", "coche", "autobus", "hotel"] },
    { "id": "c1-13", "type": "listen-choose", "prompt": "Listen to the spelling. Which word is it?", "audio": "ge, a, te, o", "optionsLang": "en", "options": ["gato", "gente", "agua"], "answer": 0, "vocab": ["gato"] },
    { "id": "c1-14", "type": "fill-blank", "es": "¿Cómo os {{llamáis}}?", "en": "What are your names? (to a group of friends)", "options": ["llamo", "llamas", "llamáis"], "vocab": ["como-os-llamais"] },
    { "id": "c1-15", "type": "match-pairs", "pairs": [["el jamón", "the ham"], ["el queso", "the cheese"], ["el zumo", "the juice"], ["la cerveza", "the beer"], ["el vino", "the wine"], ["caro", "expensive"]], "vocab": ["jamon", "queso", "zumo", "cerveza", "vino", "caro"] },
    { "id": "c1-16", "type": "dictation", "es": "España", "hint": "Spain", "vocab": ["espana"] },
    { "id": "c1-17", "type": "listen-choose", "prompt": "How much is it?", "audio": "¿Cuánto es? —Son cuatro euros.", "optionsLang": "en", "options": ["€4", "€14", "€5"], "answer": 0, "vocab": ["cuanto-es", "cuatro"] },
    { "id": "c1-18", "type": "match-pairs", "pairs": [["la hija", "the daughter"], ["el amigo", "the friend"], ["la gente", "people"], ["el señor", "the gentleman"], ["la señora", "the lady"]], "vocab": ["hija", "amigo", "gente", "senor", "senora"] },
    { "id": "c1-19", "type": "fill-blank", "es": "La cena es a las {{diez}}.", "en": "Dinner is at ten.", "options": ["diez", "dos", "doce"], "vocab": ["cena", "diez"] },
    { "id": "c1-20", "type": "repeat", "es": "Sí, vale. Muchas gracias.", "en": "Yes, OK. Thank you very much.", "vocab": ["si-yes", "vale", "muchas-gracias"] },
    { "id": "c1-21", "type": "match-pairs", "pairs": [["la calle", "the street"], ["la playa", "the beach"], ["la plaza", "the square"], ["el menú", "the set lunch"], ["aquí", "here"], ["hoy", "today"]], "vocab": ["calle", "playa", "plaza", "menu", "aqui", "hoy"] },
    { "id": "c1-22", "type": "build-sentence", "es": "Dos cafés con leche y un agua, por favor.", "en": "Two coffees with milk and a water, please.", "distractors": ["una"], "vocab": ["dos", "cafe", "leche", "uno", "agua", "y-and", "por-favor"] },
    { "id": "c1-23", "type": "fill-blank", "es": "Ahora no, {{mañana}}.", "en": "Not now, tomorrow.", "options": ["mañana", "nada", "aquí"], "vocab": ["ahora", "no", "manana"] },
    { "id": "c1-24", "type": "match-pairs", "pairs": [["cero", "0"], ["tres", "3"], ["cinco", "5"], ["seis", "6"], ["ocho", "8"], ["nueve", "9"]], "vocab": ["cero", "tres", "cinco", "seis", "ocho", "nueve"] },
    { "id": "c1-25", "type": "dictation", "es": "siete", "accept": ["7"], "hint": "a number", "vocab": ["siete"] },
    { "id": "c1-26", "type": "match-pairs", "pairs": [["la llave", "the key"], ["la letra", "the letter"], ["el nombre", "the name"], ["el apellido", "the surname"], ["tu", "your"], ["mucho", "a lot"]], "vocab": ["llave", "letra", "nombre", "apellido", "tu-your", "mucho"] },
    { "id": "c1-27", "type": "repeat", "es": "Yo me llamo Pablo. Encantado.", "en": "My name is Pablo. Nice to meet you.", "vocab": ["yo", "me-llamo", "encantado"] },
    { "id": "c1-28", "type": "shadow", "es": "No, nada. Todo bien.", "en": "No, nothing. All good.", "listenFor": "The soft d in nada and todo: a light 'th' as in 'this'.", "vocab": ["no", "nada", "todo", "bien"] }
  ]
}
