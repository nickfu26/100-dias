    { "id": "d028-13", "type": "listen-choose", "prompt": "What's wrong with the jacket?", "audio": "La chaqueta es grande. ¿Tiene una talla pequeña?", "optionsLang": "en", "options": ["It's too big", "It's too small", "It's the wrong colour"], "answer": 0, "vocab": ["chaqueta", "grande", "talla", "pequeno"] },
