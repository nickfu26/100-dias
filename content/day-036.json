{
  "$schema": "./schema.json",
  "day": 36,
  "level": 3,
  "title": { "en": "At the bar", "es": "En la barra" },
  "objectives": [
    "Order at a Madrid bar the way locals do: ¿Me pones…?",
    "Understand the barman: ¿Qué te pongo? ¿Algo más?",
    "Order for two with para mí and ¿y para ti?",
    "Ask for another round and say that's all"
  ],
  "teach": [
    {
      "kind": "note",
      "md": "**How Madrid orders.** At the bar (*la barra*), people don't say *I want*. They use **poner** (*to put*): *put me a beer*.\n\n- **¿Me pones una caña?** Can I have a beer? (literally *Do you put me a beer?*)\n- **Ponme una caña, por favor.** A beer, please. (literally *Put me a beer*)\n\nBoth are normal and friendly in Spain, not rude. Use *tú* with bar staff: that's the norm."
    },
    { "kind": "phrase", "es": "¿Qué te pongo?", "en": "What can I get you?", "note": "What the barman says. Same verb, poner: 'What do I put you?'. Pongo = I put (irregular, like tengo)." },
    { "kind": "phrase", "es": "¿Me pones una caña, por favor?", "en": "Can I have a small beer, please?", "note": "Your go-to order. To an older waiter in a formal place, use usted: ¿Me pone…? or Póngame…" },
    { "kind": "phrase", "es": "Para mí, un café con leche. ¿Y para ti?", "en": "A white coffee for me. And for you?", "note": "mí with an accent = me (after para). Without the accent, mi = my." },
    { "kind": "phrase", "es": "Otra, por favor.", "en": "Another one, please.", "note": "Hold up your glass: otra caña, otra copa. For a coffee or a wine glass of tinto: otro." },
    { "kind": "phrase", "es": "¿Algo más? No, nada más, gracias.", "en": "Anything else? No, that's all, thanks.", "note": "The barman's last question, and the answer that ends the order." },
    {
      "kind": "note",
      "md": "**Bar etiquette**\n\n- Stand at the bar or sit at a table. At the bar it's quicker and sometimes cheaper.\n- You usually **pay at the end**, not with each order.\n- Catch the barman's eye and say *¡Perdón!* if you need to. You'll learn paying on day 38."
    }
  ],
  "vocab": [
    { "id": "que-te-pongo", "es": "¿Qué te pongo?", "en": "What can I get you?", "pos": "phrase", "ipa": "ˈke te ˈpoŋgo", "note": "Heard from bar staff. Formal: ¿Qué le pongo?", "tags": ["restaurant"] },
    { "id": "me-pones", "es": "¿Me pones…?", "en": "Can I have…? (ordering)", "pos": "phrase", "ipa": "me ˈpones", "note": "Spain. Usted: ¿Me pone…?", "tags": ["restaurant", "survival"] },
    { "id": "ponme", "es": "Ponme…", "en": "I'll have… / Give me… (ordering)", "pos": "phrase", "ipa": "ˈpomme", "note": "Add por favor. Usted: Póngame…", "tags": ["restaurant"] },
    { "id": "para-mi", "es": "para mí", "en": "for me", "pos": "phrase", "ipa": "ˈpaɾa ˈmi", "note": "Accent on mí (me). mi without it = my.", "tags": ["restaurant"] },
    { "id": "y-para-ti", "es": "¿Y para ti?", "en": "And for you?", "pos": "phrase", "ipa": "i ˈpaɾa ˈti", "note": "No accent on ti.", "tags": ["restaurant"] },
    { "id": "otra-por-favor", "es": "Otra, por favor.", "en": "Another one, please.", "pos": "phrase", "ipa": "ˈotɾa poɾ faˈβoɾ", "note": "Otro for masculine drinks: otro café.", "tags": ["restaurant"] },
    { "id": "algo-mas", "es": "¿Algo más?", "en": "Anything else?", "pos": "phrase", "ipa": "ˈalɣo ˈmas", "note": "algo = something.", "tags": ["restaurant", "shopping"] },
    { "id": "nada-mas", "es": "Nada más.", "en": "That's all. Nothing else.", "pos": "phrase", "ipa": "ˈnaða ˈmas", "tags": ["restaurant", "shopping"] }
  ],
