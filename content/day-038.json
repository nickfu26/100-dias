    { "id": "cuanto-te-debo", "es": "¿Cuánto te debo?", "en": "How much do I owe you?", "pos": "phrase", "ipa": "ˈkwanto te ˈðeβo", "note": "Usted: ¿Cuánto le debo?", "tags": ["restaurant", "shopping"] },
