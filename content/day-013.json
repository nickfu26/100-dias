{
  "$schema": "./schema.json",
  "day": 13,
  "level": 2,
  "title": { "en": "Drinks", "es": "Las bebidas" },
  "objectives": [
    "Name the drinks you'll order in a Madrid bar",
    "Choose between a caña, a coffee and a glass of wine",
    "Ask for still or sparkling water",
    "Order two drinks with un / una and por favor"
  ],
  "teach": [
    { "kind": "phrase", "es": "Una caña, por favor.", "en": "A small draught beer, please.", "note": "The standard beer order in Madrid: a small glass of draught beer, about 200 ml. Ask for una cerveza and you may get a bottle." },
    {
      "kind": "note",
      "md": "**Coffee, the Spanish way**\n\n- **un café solo**: a small black espresso\n- **un cortado**: espresso with a splash of milk\n- **un café con leche**: about half coffee, half hot milk. The breakfast classic.\n\nAll three are served small. A big takeaway coffee is the exception in Spain."
    },
    { "kind": "phrase", "es": "Un vino tinto, por favor.", "en": "A red wine, please.", "note": "In a bar, un tinto alone also means a glass of red." },
    { "kind": "phrase", "es": "Un tinto de verano.", "en": "A tinto de verano.", "note": "Red wine with lemon soda over ice. Madrid drinks it more than sangría." },
    { "kind": "phrase", "es": "¿Agua con gas o sin gas?", "en": "Sparkling or still water?", "note": "The waiter's question. Answer: Sin gas, por favor. Tap water is agua del grifo." },
    { "kind": "phrase", "es": "Una botella de agua y dos vasos.", "en": "A bottle of water and two glasses.", "note": "de links the container to its contents: una botella de vino, un vaso de leche." }
  ],
  "vocab": [
    { "id": "cana", "es": "la caña", "en": "small draught beer", "pos": "noun", "gender": "f", "ipa": "ˈkaɲa", "tags": ["madrid", "bar"] },
    { "id": "cafe-solo", "es": "el café solo", "en": "espresso (black coffee)", "pos": "noun", "gender": "m", "ipa": "kaˈfe ˈsolo", "tags": ["bar"] },
    { "id": "cortado", "es": "el cortado", "en": "espresso with a dash of milk", "pos": "noun", "gender": "m", "ipa": "koɾˈtaðo", "tags": ["bar"] },
    { "id": "cafe-con-leche", "es": "el café con leche", "en": "coffee with milk", "pos": "noun", "gender": "m", "ipa": "kaˈfe kon ˈletʃe", "tags": ["bar"] },
    { "id": "te", "es": "el té", "en": "tea", "pos": "noun", "gender": "m", "ipa": "ˈte", "note": "With an accent. te without one = you (object): te quiero.", "tags": ["bar"] },
    { "id": "vino-tinto", "es": "el vino tinto", "en": "red wine", "pos": "noun", "gender": "m", "ipa": "ˈbino ˈtinto", "tags": ["bar"] },
    { "id": "vino-blanco", "es": "el vino blanco", "en": "white wine", "pos": "noun", "gender": "m", "ipa": "ˈbino ˈblaŋko", "tags": ["bar"] },
    { "id": "tinto-de-verano", "es": "el tinto de verano", "en": "red wine with lemon soda", "pos": "noun", "gender": "m", "ipa": "ˈtinto ðe βeˈɾano", "note": "verano = summer, but it's drunk all year.", "tags": ["madrid", "bar"] },
    { "id": "agua-con-gas", "es": "agua con gas", "en": "sparkling water", "pos": "phrase", "ipa": "ˈaɣwa koŋ ˈɡas", "tags": ["bar"] },
    { "id": "agua-sin-gas", "es": "agua sin gas", "en": "still water", "pos": "phrase", "ipa": "ˈaɣwa siŋ ˈɡas", "tags": ["bar"] },
    { "id": "botella", "es": "la botella", "en": "bottle", "pos": "noun", "gender": "f", "ipa": "boˈteʝa" },
    { "id": "vaso", "es": "el vaso", "en": "glass (tumbler)", "pos": "noun", "gender": "m", "ipa": "ˈbaso", "note": "Wine comes in una copa (a stemmed glass): una copa de vino." }
  ],
