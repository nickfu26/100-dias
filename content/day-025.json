    { "id": "d025-22", "type": "shadow", "es": "la taquilla", "en": "the ticket office", "listenFor": "qu sounds like k (no u), and ll like the y in yes: ta-KI-ya.", "vocab": ["taquilla"] },
    { "id": "d025-23", "type": "listen-choose", "prompt": "Review: what is he looking for?", "audio": "¿Dónde están los aseos?", "optionsLang": "en", "options": ["The toilets", "The exit", "The pharmacy"], "answer": 0, "vocab": ["aseos", "donde-esta"] },
    { "id": "d025-24", "type": "repeat", "prompt": "Review: say it aloud.", "es": "El museo abre a las diez y cierra a las ocho de la tarde.", "en": "The museum opens at ten and closes at eight in the evening.", "vocab": ["museo", "abre", "cierra", "de-la-tarde"] }
  ]
