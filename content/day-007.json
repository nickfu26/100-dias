    { "id": "d007-02", "type": "listen-choose", "audio": "la playa", "optionsLang": "en", "options": ["the beach", "the street", "the milk"], "answer": 0, "vocab": ["playa"] },
    { "id": "d007-03", "type": "listen-choose", "audio": "el coche", "optionsLang": "en", "options": ["the car", "the cat", "the dog"], "answer": 0, "vocab": ["coche"] },
    { "id": "d007-04", "type": "match-pairs", "pairs": [["la calle", "the street"], ["la playa", "the beach"], ["la llave", "the key"], ["yo", "I"], ["mucho", "a lot"]], "vocab": ["calle", "playa", "llave", "yo", "mucho"] },
    { "id": "d007-05", "type": "match-pairs", "pairs": [["el vino", "the wine"], ["la leche", "the milk"], ["el coche", "the car"], ["muchas gracias", "thank you very much"], ["¿Cómo se dice…?", "How do you say…?"]], "vocab": ["vino", "leche", "coche", "muchas-gracias", "como-se-dice"] },
    { "id": "d007-06", "type": "fill-blank", "es": "Un café con {{leche}}, por favor.", "en": "A coffee with milk, please.", "options": ["leche", "llave", "playa"], "vocab": ["cafe", "leche", "por-favor"] },
    { "id": "d007-07", "type": "fill-blank", "es": "{{Muchas}} gracias.", "en": "Thank you very much.", "options": ["Muchas", "Mucho", "Muy"], "vocab": ["muchas-gracias"] },
    { "id": "d007-08", "type": "fill-blank", "es": "Un {{vino}}, por favor.", "en": "A wine, please.", "options": ["vino", "coche", "yo"], "vocab": ["vino", "por-favor"] },
    { "id": "d007-09", "type": "build-sentence", "es": "¿Cómo se dice esto en español?", "en": "How do you say this in Spanish?", "distractors": ["mucho"], "vocab": ["como-se-dice"] },
    { "id": "d007-10", "type": "build-sentence", "es": "Un café con leche, por favor.", "en": "A coffee with milk, please.", "distractors": ["vino"], "vocab": ["cafe", "leche", "por-favor"] },
