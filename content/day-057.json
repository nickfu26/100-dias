{
  "$schema": "./schema.json",
  "day": 57,
  "level": 3,
  "title": { "en": "At the pharmacy", "es": "En la farmacia" },
  "objectives": [
    "Ask for something for a headache, a cough or a cold",
    "Ask whether you need a prescription",
    "Find the on-duty pharmacy at night or on Sunday",
    "Understand how often to take it"
  ],
  "teach": [
    {
      "kind": "note",
      "md": "**Spanish pharmacies** (look for the green cross) are the first stop for minor problems. The pharmacist (*el farmacéutico, la farmacéutica*) will listen and recommend something.\n\n- Common painkillers like paracetamol and ibuprofen are sold over the counter, at the counter.\n- Antibiotics need a prescription (**receta**).\n- At night and on Sundays, the **farmacia de guardia** (on-duty pharmacy) is open. Every pharmacy posts the list on its door. Central Madrid also has 24-hour pharmacies."
    },
    { "kind": "phrase", "es": "Hola. ¿Tiene algo para el dolor de cabeza?", "en": "Hi. Do you have something for a headache?", "note": "¿Tiene algo para…? works for anything: para la tos, para el resfriado, para el estómago. el dolor = pain." },
    { "kind": "phrase", "es": "Tengo tos y un resfriado.", "en": "I have a cough and a cold.", "note": "la tos = cough. el resfriado = cold. Also: Estoy resfriado / resfriada. You know me duele la garganta from day 32." },
    { "kind": "phrase", "es": "¿Se puede comprar sin receta?", "en": "Can you buy it without a prescription?", "note": "comprar = to buy. la receta = prescription (and recipe)." },
    { "kind": "phrase", "es": "¿Cuántas veces al día? — Una pastilla, tres veces al día.", "en": "How many times a day? — One tablet, three times a day.", "note": "la vez, las veces = time(s), occasion(s). la pastilla = tablet, pill." },
    { "kind": "phrase", "es": "¿Dónde hay una farmacia de guardia?", "en": "Where's an on-duty pharmacy?", "note": "Ask your hotel reception, or check the list on any pharmacy door." }
  ],
  "vocab": [
    { "id": "tiene-algo-para", "es": "¿Tiene algo para…?", "en": "Do you have something for…?", "pos": "phrase", "ipa": "ˈtjene ˈalɣo ˈpaɾa", "tags": ["health", "survival"] },
    { "id": "dolor-de-cabeza", "es": "el dolor de cabeza", "en": "headache", "pos": "phrase", "ipa": "el doˈloɾ ðe kaˈβeθa", "note": "el dolor = pain.", "tags": ["health"] },
    { "id": "tos", "es": "la tos", "en": "cough", "pos": "noun", "gender": "f", "ipa": "ˈtos", "note": "Tengo tos.", "tags": ["health"] },
    { "id": "resfriado", "es": "el resfriado", "en": "cold (illness)", "pos": "noun", "gender": "m", "ipa": "resfɾiˈaðo", "note": "Estoy resfriado, resfriada = I have a cold.", "tags": ["health"] },
    { "id": "sin-receta", "es": "sin receta", "en": "without a prescription", "pos": "phrase", "ipa": "sin reˈθeta", "note": "la receta = prescription; also recipe.", "tags": ["health"] },
    { "id": "farmacia-de-guardia", "es": "la farmacia de guardia", "en": "on-duty pharmacy (nights, Sundays)", "pos": "phrase", "ipa": "la faɾˈmaθja ðe ˈɣwaɾðja", "tags": ["health", "survival"] },
    { "id": "cuantas-veces-al-dia", "es": "¿Cuántas veces al día?", "en": "How many times a day?", "pos": "phrase", "ipa": "ˈkwantas ˈβeθes al ˈdia", "note": "Tres veces al día.", "tags": ["health"] }
  ],
