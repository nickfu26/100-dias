    { "id": "d007-13", "type": "dictation", "es": "vino", "hint": "wine (v, though it sounds like b)", "vocab": ["vino"] },
    { "id": "d007-14", "type": "dictation", "es": "coche", "hint": "car", "vocab": ["coche"] },
    { "id": "d007-15", "type": "repeat", "es": "Muchas gracias.", "en": "Thank you very much.", "vocab": ["muchas-gracias"] },
    { "id": "d007-16", "type": "repeat", "es": "¿Cómo se dice esto en español?", "en": "How do you say this in Spanish?", "vocab": ["como-se-dice"] },
    { "id": "d007-17", "type": "shadow", "es": "la calle, la playa, yo", "en": "the street, the beach, I", "listenFor": "ll and y make exactly the same sound.", "vocab": ["calle", "playa", "yo"] },
    { "id": "d007-18", "type": "shadow", "es": "vale, bien, el vino, por favor", "en": "OK, well, the wine, please", "listenFor": "A firm b in vale and bien; softer lips in el vino and favor. No English v.", "vocab": ["vale", "bien", "vino", "por-favor"] },
    { "id": "d007-19", "type": "listen-choose", "prompt": "Review: one r or two?", "audio": "caro", "options": ["caro", "carro"], "answer": 0, "vocab": ["caro"] },
    { "id": "d007-20", "type": "dictation", "prompt": "Review: type what you hear.", "es": "mañana", "hint": "tomorrow", "vocab": ["manana"] },
    { "id": "d007-21", "type": "repeat", "prompt": "Review: say it aloud.", "es": "Hoy no, mañana.", "en": "Not today, tomorrow.", "vocab": ["hoy", "manana"] }
  ]
