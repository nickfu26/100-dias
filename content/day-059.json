    { "id": "d059-04", "type": "match-pairs", "pairs": [["He perdido…", "I've lost…"], ["Me han robado…", "Someone has stolen my…"], ["la cartera", "wallet"], ["la recepción", "reception"], ["¿Qué hago?", "What should I do?"], ["el carterista", "pickpocket"]], "vocab": ["he-perdido", "me-han-robado", "cartera", "recepcion", "que-hago", "carterista"] },
