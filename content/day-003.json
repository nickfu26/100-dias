    { "id": "d003-02", "type": "listen-choose", "audio": "ahora", "optionsLang": "en", "options": ["now", "today", "nothing"], "answer": 0, "vocab": ["ahora"] },
    { "id": "d003-03", "type": "listen-choose", "audio": "aquí", "optionsLang": "en", "options": ["here", "everything", "please"], "answer": 0, "vocab": ["aqui"] },
    { "id": "d003-04", "type": "listen-choose", "prompt": "Soft d or t? Pick the word you hear.", "audio": "nada", "options": ["nada", "nata"], "answer": 0, "vocab": ["nada"] },
    { "id": "d003-05", "type": "listen-choose", "audio": "el ordenador", "optionsLang": "en", "options": ["the computer", "the hotel", "the cheese"], "answer": 0, "vocab": ["ordenador"] },
    { "id": "d003-06", "type": "match-pairs", "pairs": [["por favor", "please"], ["perdón", "sorry / excuse me"], ["hoy", "today"], ["ahora", "now"], ["aquí", "here"]], "vocab": ["por-favor", "perdon", "hoy", "ahora", "aqui"] },
    { "id": "d003-07", "type": "match-pairs", "pairs": [["el hotel", "the hotel"], ["el queso", "the cheese"], ["el ordenador", "the computer"], ["nada", "nothing"], ["todo", "everything"]], "vocab": ["hotel", "queso", "ordenador", "nada", "todo"] },
    { "id": "d003-08", "type": "fill-blank", "es": "Un café, {{por favor}}.", "en": "A coffee, please.", "options": ["por favor", "perdón", "nada"], "vocab": ["cafe", "por-favor"] },
    { "id": "d003-09", "type": "fill-blank", "es": "{{Hoy}} no, gracias.", "en": "Not today, thanks.", "options": ["Hoy", "Hola", "Aquí"], "vocab": ["hoy", "gracias"] },
    { "id": "d003-10", "type": "fill-blank", "es": "{{Todo}} bien.", "en": "All good.", "options": ["Todo", "Nada", "Hoy"], "vocab": ["todo", "bien"] },
    { "id": "d003-11", "type": "build-sentence", "es": "Un café, por favor.", "en": "A coffee, please.", "distractors": ["perdón"], "vocab": ["cafe", "por-favor"] },
    { "id": "d003-12", "type": "build-sentence", "es": "Ahora no, gracias.", "en": "Not now, thanks.", "distractors": ["hoy"], "vocab": ["ahora", "gracias"] },
    { "id": "d003-13", "type": "dictation", "es": "hotel", "hint": "hotel (the h is written but silent)", "vocab": ["hotel"] },
    { "id": "d003-14", "type": "dictation", "es": "nada", "hint": "nothing", "vocab": ["nada"] },
    { "id": "d003-15", "type": "dictation", "es": "aquí", "hint": "here (accent on the i)", "vocab": ["aqui"] },
    { "id": "d003-16", "type": "repeat", "es": "Por favor.", "en": "Please.", "vocab": ["por-favor"] },
    { "id": "d003-17", "type": "repeat", "es": "Perdón.", "en": "Sorry. / Excuse me.", "vocab": ["perdon"] },
    { "id": "d003-18", "type": "shadow", "es": "nada, todo, Madrid", "en": "nothing, everything, Madrid", "listenFor": "The soft d between vowels and at the end of Madrid: a light 'th' as in 'this'.", "vocab": ["nada", "todo"] },
    { "id": "d003-19", "type": "shadow", "es": "hola, hotel, hoy, ahora", "en": "hello, hotel, today, now", "listenFor": "No h sound at all. Each word starts on the vowel.", "vocab": ["hola", "hotel", "hoy", "ahora"] },
    { "id": "d003-20", "type": "listen-choose", "prompt": "Review: what does it mean?", "audio": "vale", "optionsLang": "en", "options": ["OK", "thank you", "very"], "answer": 0, "vocab": ["vale"] },
    { "id": "d003-21", "type": "dictation", "prompt": "Review: type what you hear.", "es": "gracias", "hint": "thank you", "vocab": ["gracias"] },
    { "id": "d003-22", "type": "repeat", "prompt": "Review: say it aloud.", "es": "Muy bien, ¿y tú?", "en": "Very well, and you?", "vocab": ["muy", "bien", "y-and", "tu-you"] }
  ]
