{
  "$schema": "./schema.json",
  "day": 25,
  "level": 2,
  "title": { "en": "Getting around", "es": "Por Madrid" },
  "objectives": [
    "Name the metro, train, stops and stations",
    "Read the signs: entrada, salida, taquilla",
    "Find a cash machine, a market and the cathedral"
  ],
  "teach": [
    {
      "kind": "note",
      "md": "**Getting around Madrid**\n\n- **el metro**: the underground. Sol is the station at the centre of everything.\n- **la parada**: a stop (bus, or a metro station on the map)\n- **el tren**: train. Trains run from **Atocha** and **Chamartín**, and the airport has a train station at T4.\n\nYou'll learn tickets (*el billete*) and lines properly in Level 3."
    },
    {
      "kind": "note",
      "md": "**Signs you'll see everywhere**\n\n- **ENTRADA**: way in. **La entrada** is also a ticket for a museum, a show or a match.\n- **SALIDA**: way out. At the airport, **Salidas** = Departures.\n- **TAQUILLA**: ticket office, box office"
    },
    { "kind": "phrase", "es": "¿Dónde está la salida?", "en": "Where is the exit?", "note": "Big metro stations like Sol have several exits. Signs name the street each one comes out on." },
    { "kind": "phrase", "es": "Dos entradas, por favor.", "en": "Two tickets, please.", "note": "At a museum taquilla. For the metro or a train you'll say billete instead." },
    { "kind": "phrase", "es": "¿Hay un cajero cerca?", "en": "Is there a cash machine nearby?", "note": "Short for cajero automático. Banks' own machines are usually cheaper than the stand-alone ones in tourist areas." },
    { "kind": "phrase", "es": "el mercado y la catedral", "en": "the market and the cathedral", "note": "The Mercado de San Miguel is next to the Plaza Mayor. The Catedral de la Almudena is next to the Royal Palace." }
  ],
  "vocab": [
    { "id": "metro", "es": "el metro", "en": "metro, underground", "pos": "noun", "gender": "m", "ipa": "ˈmetɾo", "tags": ["transport", "madrid"] },
    { "id": "parada", "es": "la parada", "en": "stop (bus, metro)", "pos": "noun", "gender": "f", "ipa": "paˈɾaða", "tags": ["transport"] },
    { "id": "tren", "es": "el tren", "en": "train", "pos": "noun", "gender": "m", "ipa": "ˈtɾen", "tags": ["transport"] },
    { "id": "mercado", "es": "el mercado", "en": "market", "pos": "noun", "gender": "m", "ipa": "meɾˈkaðo", "tags": ["madrid", "shopping"] },
    { "id": "catedral", "es": "la catedral", "en": "cathedral", "pos": "noun", "gender": "f", "ipa": "kateˈðɾal", "tags": ["madrid"] },
    { "id": "entrada", "es": "la entrada", "en": "entrance; ticket (museum, show)", "pos": "noun", "gender": "f", "ipa": "enˈtɾaða", "note": "A transport ticket is el billete.", "tags": ["madrid"] },
    { "id": "salida", "es": "la salida", "en": "exit; departure", "pos": "noun", "gender": "f", "ipa": "saˈliða", "note": "Airport: Salidas = Departures.", "tags": ["transport"] },
    { "id": "taquilla", "es": "la taquilla", "en": "ticket office, box office", "pos": "noun", "gender": "f", "ipa": "taˈkiʝa", "tags": ["transport", "madrid"] },
    { "id": "cajero", "es": "el cajero", "en": "cash machine, ATM", "pos": "noun", "gender": "m", "ipa": "kaˈxeɾo", "note": "Short for el cajero automático.", "tags": ["survival"] }
  ],
