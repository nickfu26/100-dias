    { "id": "pincho-de-tortilla", "es": "un pincho de tortilla", "en": "a slice of tortilla", "pos": "phrase", "ipa": "um ˈpintʃo ðe toɾˈtiʝa", "note": "pincho = a single bar portion.", "tags": ["restaurant", "madrid"] },
