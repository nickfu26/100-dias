    { "id": "d014-08", "type": "fill-blank", "es": "Un bocadillo de {{calamares}}, por favor.", "en": "A squid sandwich, please.", "options": ["calamares", "aceitunas", "vasos"], "vocab": ["bocadillo", "calamares"] },
    { "id": "d014-09", "type": "fill-blank", "es": "{{Unas}} patatas bravas y dos cañas.", "en": "Some patatas bravas and two small beers.", "options": ["Unas", "Unos", "Una"], "vocab": ["patatas-bravas", "unos-unas", "cana"] },
    { "id": "d014-10", "type": "fill-blank", "es": "Una tapa de {{tortilla}}, por favor.", "en": "A tapa of Spanish omelette, please.", "options": ["tortilla", "croquetas", "pan"], "vocab": ["tapa", "tortilla"] },
    { "id": "d014-11", "type": "listen-choose", "prompt": "What did they order?", "audio": "Una ración de croquetas y unas aceitunas.", "optionsLang": "en", "options": ["Croquettes + olives", "Squid + olives", "Croquettes + bread"], "answer": 0, "vocab": ["racion", "croquetas", "aceitunas"] },
    { "id": "d014-12", "type": "listen-choose", "prompt": "What did they order?", "audio": "Un bocadillo de jamón y una caña.", "optionsLang": "en", "options": ["A ham sandwich + a beer", "A cheese sandwich + a beer", "A ham sandwich + a wine"], "answer": 0, "vocab": ["bocadillo", "jamon", "cana"] },
    { "id": "d014-13", "type": "dictation", "es": "las croquetas", "hint": "croquettes", "vocab": ["croquetas"] },
    { "id": "d014-14", "type": "dictation", "es": "la ración", "hint": "a plate to share (watch the accent)", "vocab": ["racion"] },
    { "id": "d014-15", "type": "dictation", "es": "el pan", "hint": "bread", "vocab": ["pan"] },
    { "id": "d014-16", "type": "build-sentence", "es": "Una ración de patatas bravas, por favor.", "en": "A plate of patatas bravas, please.", "distractors": ["tapa", "con"], "vocab": ["racion", "patatas-bravas"] },
    { "id": "d014-17", "type": "build-sentence", "es": "¿Hay tortilla? Sí, y croquetas.", "en": "Is there any omelette? Yes, and croquettes.", "distractors": ["no"], "vocab": ["hay-q", "tortilla", "croquetas"] },
