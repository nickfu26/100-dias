    { "id": "d059-10", "type": "listen-choose", "prompt": "Where should she go?", "audio": "Para la denuncia, a la comisaría. Hay una cerca de la Plaza de España.", "optionsLang": "en", "options": ["To a police station near Plaza de España", "To the embassy", "To hotel reception"], "answer": 0, "vocab": ["poner-una-denuncia", "comisaria", "cerca"] },
