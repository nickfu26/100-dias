{
  "$schema": "./schema.json",
  "day": 14,
  "level": 2,
  "title": { "en": "Bar food", "es": "De tapas" },
  "objectives": [
    "Tell a tapa from a ración",
    "Name the classic Madrid bar dishes",
    "Use de for what something is made of: croquetas de jamón",
    "Order food and drink together"
  ],
  "teach": [
    {
      "kind": "note",
      "md": "**Tapa or ración?**\n\n- **una tapa**: a small plate, sometimes free with your drink in Madrid\n- **una ración**: a full plate to share\n\nMenus often list both sizes, and sometimes **media ración** (half) too."
    },
    { "kind": "phrase", "es": "una tortilla de patatas", "en": "a Spanish potato omelette", "note": "In Spain una tortilla is this thick egg and potato omelette, not a wrap. Patatas, not papas." },
    { "kind": "phrase", "es": "unas patatas bravas", "en": "fried potatoes with spicy sauce", "note": "Madrid's own tapa. Order them as plural: unas bravas." },
    { "kind": "phrase", "es": "unas croquetas de jamón", "en": "ham croquettes", "note": "de tells you what it's made of: croquetas de jamón, bocadillo de queso." },
    { "kind": "phrase", "es": "un bocadillo de calamares", "en": "a fried squid sandwich", "note": "Madrid's most famous snack, sold all around the Plaza Mayor. A bocadillo is a sandwich on a crusty baguette." },
    { "kind": "phrase", "es": "unas aceitunas y pan", "en": "some olives and bread", "note": "Often the first thing on the table. Bread is usually charged on the bill, so you can say no if you don't want it." }
  ],
  "vocab": [
    { "id": "tapa", "es": "la tapa", "en": "tapa (small plate)", "pos": "noun", "gender": "f", "ipa": "ˈtapa", "tags": ["madrid", "bar"] },
    { "id": "racion", "es": "la ración", "en": "portion (plate to share)", "pos": "noun", "gender": "f", "ipa": "raˈθjon", "note": "Plural: las raciones (no accent).", "tags": ["bar"] },
    { "id": "patatas-bravas", "es": "las patatas bravas", "en": "fried potatoes with spicy sauce", "pos": "noun", "gender": "f", "ipa": "paˈtatas ˈβɾaβas", "note": "una patata = a potato. LatAm: la papa.", "tags": ["madrid", "bar"] },
    { "id": "tortilla", "es": "la tortilla", "en": "Spanish omelette (egg and potato)", "pos": "noun", "gender": "f", "ipa": "toɾˈtiʝa", "note": "In full: la tortilla de patatas, or tortilla española.", "tags": ["bar"] },
    { "id": "croquetas", "es": "las croquetas", "en": "croquettes", "pos": "noun", "gender": "f", "ipa": "kɾoˈketas", "tags": ["bar"] },
    { "id": "calamares", "es": "los calamares", "en": "fried squid rings", "pos": "noun", "gender": "m", "ipa": "kalaˈmaɾes", "note": "Calamares a la romana = battered squid rings.", "tags": ["madrid", "bar"] },
    { "id": "bocadillo", "es": "el bocadillo", "en": "sandwich (on a baguette)", "pos": "noun", "gender": "m", "ipa": "bokaˈðiʝo", "note": "Sliced-bread sandwiches are un sándwich.", "tags": ["madrid", "bar"] },
    { "id": "aceitunas", "es": "las aceitunas", "en": "olives", "pos": "noun", "gender": "f", "ipa": "aθeiˈtunas", "tags": ["bar"] },
    { "id": "pan", "es": "el pan", "en": "bread", "pos": "noun", "gender": "m", "ipa": "ˈpan" }
  ],
  "exercises": [
