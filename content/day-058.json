{
  "$schema": "./schema.json",
  "day": 58,
  "level": 3,
  "title": { "en": "I'm lost", "es": "Me he perdido" },
  "objectives": [
    "Say you're lost and what you're looking for",
    "Ask someone to show you on the map",
    "Ask for help, and know the emergency number"
  ],
  "teach": [
    { "kind": "phrase", "es": "Perdone, me he perdido.", "en": "Excuse me, I'm lost.", "note": "Literally 'I have lost myself'. The same for men and women: perdido doesn't change." },
    { "kind": "phrase", "es": "Estoy buscando la Plaza Mayor.", "en": "I'm looking for the Plaza Mayor.", "note": "estoy buscando = I'm looking for (right now). You met buscar on day 33." },
    { "kind": "phrase", "es": "¿Me lo enseña en el mapa?", "en": "Can you show me on the map?", "note": "enseñar = to show. Hold out your phone: en el móvil works too. With tú: ¿Me lo enseñas?" },
    { "kind": "phrase", "es": "¿Me puede ayudar, por favor?", "en": "Can you help me, please?", "note": "The polite all-purpose request. You heard the shop version, ¿Te puedo ayudar?, on day 45." },
    {
      "kind": "note",
      "md": "**Emergencies.** In Spain, and across the EU, the emergency number is **112**: *el ciento doce*. It's free, works from any phone, and operators speak English.\n\nTo shout for help: **¡Socorro!** You'll probably never need it, but you should be able to say it without thinking."
    }
  ],
  "vocab": [
