    { "id": "d025-04", "type": "match-pairs", "pairs": [["el metro", "metro"], ["el tren", "train"], ["la parada", "stop"], ["el cajero", "cash machine"], ["el mercado", "market"]], "vocab": ["metro", "tren", "parada", "cajero", "mercado"] },
    { "id": "d025-05", "type": "match-pairs", "pairs": [["la entrada", "way in; ticket"], ["la salida", "way out"], ["la taquilla", "ticket office"], ["la catedral", "cathedral"]], "vocab": ["entrada", "salida", "taquilla", "catedral"] },
    { "id": "d025-06", "type": "fill-blank", "es": "¿Dónde está la {{salida}}?", "en": "Where is the exit?", "options": ["salida", "entrada", "parada"], "vocab": ["salida", "donde-esta"] },
    { "id": "d025-07", "type": "fill-blank", "es": "Dos {{entradas}}, por favor.", "en": "Two tickets, please.", "options": ["entradas", "salidas", "paradas"], "prompt": "At the museum taquilla.", "vocab": ["entrada", "dos"] },
