    { "id": "d059-12", "type": "listen-choose", "prompt": "What does the police officer say?", "audio": "Para el pasaporte nuevo, tiene que ir a la embajada de su país.", "optionsLang": "en", "options": ["Go to your country's embassy for a new passport", "Come back tomorrow", "Call 112"], "answer": 0, "vocab": ["embajada", "tengo-que", "ir"] },
