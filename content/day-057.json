    { "id": "d057-09", "type": "fill-blank", "es": "Tengo un {{resfriado}}.", "en": "I have a cold.", "options": ["resfriado", "retraso", "descuento"], "vocab": ["resfriado", "tengo"] },
    { "id": "d057-10", "type": "listen-choose", "prompt": "How often?", "audio": "Una pastilla, tres veces al día.", "optionsLang": "en", "options": ["Three times a day", "Every three hours", "Once a day for three days"], "answer": 0, "vocab": ["cuantas-veces-al-dia", "tres"] },
    { "id": "d057-11", "type": "listen-choose", "prompt": "Can you buy it without a prescription?", "audio": "Sin receta, no. Necesita una receta del médico.", "optionsLang": "en", "options": ["No, you need a doctor's prescription", "Yes, no problem", "Only at the duty pharmacy"], "answer": 0, "vocab": ["sin-receta", "necesito"] },
    { "id": "d057-12", "type": "listen-choose", "prompt": "Where's the duty pharmacy?", "audio": "La farmacia de guardia está en la calle Mayor, al lado del banco.", "optionsLang": "en", "options": ["Calle Mayor, next to the bank", "Calle Mayor, opposite the bank", "Gran Vía, next to the bank"], "answer": 0, "vocab": ["farmacia-de-guardia", "al-lado-de", "banco"] },
    { "id": "d057-13", "type": "listen-choose", "prompt": "What's wrong with him?", "audio": "Me duele la garganta y tengo tos.", "optionsLang": "en", "options": ["Sore throat and a cough", "Headache and a cough", "Sore throat and a cold"], "answer": 0, "vocab": ["me-duele", "garganta", "tos"] },
