    { "id": "d047-04", "type": "match-pairs", "pairs": [["¿Cuánto pide por esto?", "How much do you want for this?"], ["¿Me hace un precio?", "Can you do me a deal?"], ["¿Me lo deja en…?", "Will you let me have it for…?"], ["Es un poco caro.", "It's a bit expensive."], ["Le doy…", "I'll give you…"], ["Trato hecho.", "Deal."]], "vocab": ["cuanto-pide", "me-hace-un-precio", "me-lo-deja-en", "es-un-poco-caro", "le-doy", "trato-hecho"] },
