    { "id": "treinta-y-uno", "es": "treinta y uno", "en": "thirty-one", "pos": "num", "ipa": "ˈtɾeinta i ˈuno", "note": "The pattern for 31–99: tens + y + units." },
    { "id": "cuarenta", "es": "cuarenta", "en": "forty", "pos": "num", "ipa": "kwaˈɾenta" },
