    { "id": "d059-10", "type": "listen-choose", "prompt": "What does reception tell her?", "audio": "Tiene que ir a la comisaría. Hay una cerca de la Plaza de España.", "optionsLang": "en", "options": ["Go to a police station near Plaza de España", "Wait here at reception", "Call 112"], "answer": 0, "vocab": ["comisaria", "tengo-que", "ir", "cerca"] },
    { "id": "d059-11", "type": "listen-choose", "prompt": "What happened?", "audio": "En el metro, un carterista me ha robado la cartera.", "optionsLang": "en", "options": ["A pickpocket stole her wallet on the metro", "She lost her wallet in a shop", "Her phone was stolen in the street"], "answer": 0, "vocab": ["carterista", "cartera", "me-han-robado", "metro"] },
    { "id": "d059-12", "type": "listen-choose", "prompt": "What does the receptionist ask?", "audio": "¿Qué ha perdido? ¿El pasaporte o la cartera?", "optionsLang": "en", "options": ["What did you lose: your passport or your wallet?", "Where did you lose it?", "Was it stolen on the metro?"], "answer": 0, "vocab": ["he-perdido", "cartera"] },
    { "id": "d059-13", "type": "listen-choose", "prompt": "What does the man shout?", "audio": "¡Cuidado con el móvil!", "optionsLang": "en", "options": ["Careful with your phone!", "Your phone is ringing!", "Turn off your phone!"], "answer": 0, "vocab": ["cuidado", "movil"] },
