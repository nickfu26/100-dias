{
  "$schema": "./schema.json",
  "day": 33,
  "level": 2,
  "title": { "en": "Regular -ar verbs", "es": "Verbos en -ar" },
  "objectives": [
    "Conjugate any regular -ar verb in the present",
    "Ask ¿Hablas inglés? and ¿Habla inglés?",
    "Use buscar, llegar, tomar, pagar and trabajar in short sentences"
  ],
  "teach": [
    {
      "kind": "note",
      "md": "**The good news:** most Spanish verbs are regular, and the biggest group ends in **-ar**. Drop the -ar and add the endings:\n\n**-o, -as, -a, -amos, -áis, -an**\n\nLearn one, and you can use hundreds."
    },
    {
      "kind": "conjugation",
      "verb": "hablar",
      "verbEn": "to speak, to talk",
      "tense": "present",
      "forms": {
        "yo": "hablo",
        "tu": "hablas",
        "el": "habla",
        "nosotros": "hablamos",
        "vosotros": "habláis",
        "ellos": "hablan"
      }
    },
    { "kind": "phrase", "es": "¿Hablas inglés?", "en": "Do you speak English?", "note": "To staff or an older stranger: ¿Habla inglés? Try your Spanish first, though. People appreciate it." },
    { "kind": "phrase", "es": "Hablo un poco de español.", "en": "I speak a little Spanish.", "note": "un poco de = a little. Languages are lowercase, like nationalities: el español, el inglés." },
    {
      "kind": "note",
      "md": "**Five more, same endings**\n\n- **buscar**: to look for. *Busco la estación.* (no word for *for*)\n- **llegar**: to arrive. *Llego a Madrid el trece.*\n- **tomar**: to take, to have (food or drink). *¿Qué tomas?* = What are you having?\n- **pagar**: to pay. *Pago yo.* = I'll pay.\n- **trabajar**: to work. *Trabajo en un banco.*"
    },
    { "kind": "phrase", "es": "Llego a Madrid el miércoles.", "en": "I arrive in Madrid on Wednesday.", "note": "Spanish often uses the present for fixed plans, like English 'I arrive on Wednesday'. Arrive in a city = llegar a." }
  ],
  "vocab": [
    { "id": "hablar", "es": "hablar", "en": "to speak, to talk", "pos": "verb", "ipa": "aˈβlaɾ", "note": "hablo, hablas, habla, hablamos, habláis, hablan" },
    { "id": "hablas-ingles", "es": "¿Hablas inglés?, ¿Habla inglés?", "en": "Do you speak English?", "pos": "phrase", "ipa": "ˈaβlas iŋˈɡles, ˈaβla iŋˈɡles", "note": "habla = usted.", "tags": ["survival"] },
    { "id": "buscar", "es": "buscar", "en": "to look for", "pos": "verb", "ipa": "busˈkaɾ", "note": "Busco el hotel = I'm looking for the hotel." },
    { "id": "llegar", "es": "llegar", "en": "to arrive", "pos": "verb", "ipa": "ʝeˈɣaɾ", "note": "llegar a = arrive in / at.", "tags": ["transport"] },
    { "id": "tomar", "es": "tomar", "en": "to take; to have (food, drink)", "pos": "verb", "ipa": "toˈmaɾ", "note": "¿Qué tomas? = What are you having?", "tags": ["restaurant"] },
    { "id": "pagar", "es": "pagar", "en": "to pay", "pos": "verb", "ipa": "paˈɣaɾ", "note": "Pago yo = I'll pay.", "tags": ["shopping", "restaurant"] },
    { "id": "trabajar", "es": "trabajar", "en": "to work", "pos": "verb", "ipa": "tɾaβaˈxaɾ" }
  ],
