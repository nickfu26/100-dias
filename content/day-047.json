{
  "$schema": "./schema.json",
  "day": 47,
  "level": 3,
  "title": { "en": "Markets and haggling", "es": "El mercado y el Rastro" },
  "objectives": [
    "Know where you can haggle in Madrid, and where you can't",
    "Ask the price of something: ¿Cuánto pide por esto?",
    "Make an offer and close the deal"
  ],
  "teach": [
    {
      "kind": "note",
      "md": "**El Rastro** is Madrid's flea market: **Sunday mornings** (and public holidays), roughly 9:00 to 15:00, on the streets down from La Latina metro.\n\n- Haggling is normal at the stalls. Keep it friendly: offer a bit below the price, not half.\n- It gets very crowded. Keep your phone and wallet in a front pocket.\n- Your only Sunday is the 17th, the day you fly to Marrakesh. A morning visit works if your flight is in the afternoon.\n\n**El Mercado de San Miguel** (next to the Plaza Mayor) is a covered food market with fixed prices. No haggling there, or in shops."
    },
    { "kind": "phrase", "es": "Perdone, ¿cuánto pide por esto?", "en": "Excuse me, how much do you want for this?", "note": "esto = this (thing), when you point and don't know the word. pide = you ask (usted). Many stallholders use tú: ¿Cuánto pides?" },
    { "kind": "phrase", "es": "Es un poco caro. ¿Me hace un precio?", "en": "It's a bit expensive. Can you do me a deal?", "note": "un poco = a bit. ¿Me hace un precio? = literally 'Will you make me a price?'." },
    { "kind": "phrase", "es": "¿Me lo deja en diez?", "en": "Will you let me have it for ten?", "note": "dejar en = to let something go for (a price). Feminine: ¿Me la deja en diez?" },
    { "kind": "phrase", "es": "Le doy ocho.", "en": "I'll give you eight.", "note": "le = (to) you, usted. With tú: Te doy ocho." },
    { "kind": "phrase", "es": "Vale, diez. — Trato hecho.", "en": "OK, ten. — Deal.", "note": "Trato hecho = deal done. Shake on it, pay in cash: stalls rarely take cards." }
  ],
  "vocab": [
    { "id": "esto", "es": "esto", "en": "this (thing)", "pos": "pron", "ipa": "ˈesto", "note": "For pointing at something without naming it.", "tags": ["shopping"] },
    { "id": "cuanto-pide", "es": "¿Cuánto pide por esto?", "en": "How much do you want for this?", "pos": "phrase", "ipa": "ˈkwanto ˈpiðe poɾ ˈesto", "note": "With tú: ¿Cuánto pides?", "tags": ["shopping", "madrid"] },
    { "id": "es-un-poco-caro", "es": "Es un poco caro.", "en": "It's a bit expensive.", "pos": "phrase", "ipa": "es um ˈpoko ˈkaɾo", "note": "un poco = a bit.", "tags": ["shopping"] },
    { "id": "me-hace-un-precio", "es": "¿Me hace un precio?", "en": "Can you do me a deal?", "pos": "phrase", "ipa": "me ˈaθe um ˈpɾeθjo", "note": "el precio = price. With tú: ¿Me haces un precio?", "tags": ["shopping"] },
    { "id": "me-lo-deja-en", "es": "¿Me lo deja en…?", "en": "Will you let me have it for…?", "pos": "phrase", "ipa": "me lo ˈðexa en", "note": "With tú: ¿Me lo dejas en…?", "tags": ["shopping"] },
    { "id": "le-doy", "es": "Le doy…", "en": "I'll give you…", "pos": "phrase", "ipa": "le ˈðoi", "note": "doy = I give. With tú: Te doy…", "tags": ["shopping"] },
    { "id": "trato-hecho", "es": "Trato hecho.", "en": "Deal.", "pos": "phrase", "ipa": "ˈtɾato ˈetʃo", "tags": ["shopping"] }
  ],
