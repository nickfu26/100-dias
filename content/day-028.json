    { "id": "d028-18", "type": "build-sentence", "es": "Quería una camiseta blanca, por favor.", "en": "I'd like a white T-shirt, please.", "distractors": ["blanco", "un"], "vocab": ["queria", "camiseta", "blanco"] },
    { "id": "d028-19", "type": "build-sentence", "es": "¿De qué color es el abrigo?", "en": "What colour is the coat?", "distractors": ["hora", "la"], "vocab": ["de-que-color", "abrigo"] },
    { "id": "d028-20", "type": "build-sentence", "direction": "audio-to-es", "es": "Tengo un abrigo negro y una bufanda roja.", "en": "I have a black coat and a red scarf.", "distractors": ["negra", "rojo"], "vocab": ["tengo", "abrigo", "negro", "bufanda", "rojo"] },
