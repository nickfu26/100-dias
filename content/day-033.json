    { "id": "d033-23", "type": "listen-choose", "prompt": "Review: what hurts?", "audio": "Me duele la garganta.", "optionsLang": "en", "options": ["Her throat", "Her head", "Her back"], "answer": 0, "vocab": ["me-duele", "garganta"] },
