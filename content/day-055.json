  "teach": [
    { "kind": "phrase", "es": "Hola. Quiero facturar la maleta.", "en": "Hi. I'd like to check in my suitcase.", "note": "facturar = to check in (a bag). Not la factura (invoice), from day 50." },
    { "kind": "phrase", "es": "Solo llevo equipaje de mano.", "en": "I only have hand luggage.", "note": "llevo = I carry, I have with me (from llevar, as in Me lo llevo)." },
    { "kind": "phrase", "es": "¿Ventanilla o pasillo? — Ventanilla, por favor.", "en": "Window or aisle? — Window, please.", "note": "la ventanilla = window (on a plane, train or car). el pasillo = aisle, corridor." },
    { "kind": "phrase", "es": "Aquí tiene su tarjeta de embarque. Puerta veinticuatro.", "en": "Here's your boarding pass. Gate twenty-four.", "note": "el embarque = boarding. la puerta de embarque = the gate. Gates can change: check the screens." },
    {
      "kind": "note",
      "md": "**Your Barajas morning, Sunday 17 January** (Madrid → Marrakesh):\n\n1. **DIVA kiosk** for any tax-free forms (day 46), *before* you check in your bags.\n2. **Facturar**: check in your bag.\n3. **El control de seguridad**: security. No liquids over 100 ml in hand luggage.\n4. **El control de pasaportes**: Morocco is outside the EU, so you go through passport control on the way out.\n5. **La puerta de embarque**: your gate."
    },
    { "kind": "phrase", "es": "¿Dónde está el control de seguridad?", "en": "Where's security?", "note": "la seguridad = security, safety." }
  ],
  "vocab": [
