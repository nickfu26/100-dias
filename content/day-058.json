    { "id": "estoy-buscando", "es": "Estoy buscando…", "en": "I'm looking for…", "pos": "phrase", "ipa": "esˈtoi βusˈkando", "tags": ["survival", "directions"] },
    { "id": "me-lo-ensena", "es": "¿Me lo enseña en el mapa?", "en": "Can you show me on the map?", "pos": "phrase", "ipa": "me lo enˈseɲa en el ˈmapa", "note": "enseñar = to show. With tú: ¿Me lo enseñas?", "tags": ["directions"] },
    { "id": "mapa", "es": "el mapa", "en": "map", "pos": "noun", "gender": "m", "ipa": "ˈmapa", "note": "Masculine, even though it ends in -a.", "tags": ["directions"] },
    { "id": "me-puede-ayudar", "es": "¿Me puede ayudar?", "en": "Can you help me?", "pos": "phrase", "ipa": "me ˈpweðe aʝuˈðaɾ", "note": "With tú: ¿Me puedes ayudar?", "tags": ["survival"] },
    { "id": "socorro", "es": "¡Socorro!", "en": "Help!", "pos": "interj", "ipa": "soˈkoro", "tags": ["survival"] },
