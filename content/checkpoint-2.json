{
  "$schema": "./schema.json",
  "checkpoint": 2,
  "level": 2,
  "title": { "en": "Level 2 test: words", "es": "Prueba del nivel dos" },
  "passMark": 0.8,
  "exercises": [
    { "id": "c2-01", "type": "match-pairs", "prompt": "Food and drink.", "pairs": [["la caña", "small draught beer"], ["el cortado", "espresso with a dash of milk"], ["la ración", "full plate to share"], ["el pescado", "fish"], ["el postre", "dessert"], ["las aceitunas", "olives"]], "vocab": ["cana", "cortado", "racion", "pescado", "postre", "aceitunas"] },
    { "id": "c2-02", "type": "listen-choose", "prompt": "What does she order?", "audio": "Un café solo y un zumo, por favor.", "optionsLang": "en", "options": ["Black coffee + juice", "White coffee + juice", "Black coffee + water"], "answer": 0, "vocab": ["cafe-solo", "zumo"] },
    { "id": "c2-03", "type": "fill-blank", "prompt": "Articles.", "es": "{{Las}} patatas bravas y el pan.", "en": "The patatas bravas and the bread.", "options": ["Las", "Los", "La"], "vocab": ["patatas-bravas", "pan", "las-the"] },
    { "id": "c2-04", "type": "fill-blank", "prompt": "ser.", "es": "¿De dónde {{eres}}?", "en": "Where are you from?", "options": ["eres", "estás", "es"], "vocab": ["de-donde-eres"] },
    { "id": "c2-05", "type": "listen-choose", "prompt": "Which number?", "audio": "setenta y seis", "optionsLang": "en", "options": ["76", "66", "67"], "answer": 0, "vocab": ["setenta", "seis"] },
    { "id": "c2-06", "type": "listen-choose", "prompt": "How much is it?", "audio": "Son cuarenta y cinco con veinte.", "optionsLang": "en", "options": ["€45.20", "€54.20", "€45.12"], "answer": 0, "vocab": ["son-con", "cuarenta", "veinte"] },
    { "id": "c2-07", "type": "fill-blank", "prompt": "querer.", "es": "{{Quería}} otra caña, por favor.", "en": "I'd like another beer, please.", "options": ["Quería", "Quiere", "Quieres"], "vocab": ["queria", "otro", "cana"] },
    { "id": "c2-08", "type": "fill-blank", "prompt": "tener.", "es": "Tengo {{sed}}. ¿Tiene agua?", "en": "I'm thirsty. Do you have water?", "options": ["sed", "hambre", "calor"], "vocab": ["tengo-sed", "tienes-q", "agua"] },
    { "id": "c2-09", "type": "listen-choose", "prompt": "Which date?", "audio": "el domingo diecisiete de enero", "optionsLang": "en", "options": ["Sunday 17 January", "Saturday 17 January", "Sunday 7 January"], "answer": 0, "vocab": ["domingo", "enero", "fecha"] },
    { "id": "c2-10", "type": "listen-choose", "prompt": "What time is it?", "audio": "Son las once menos cuarto.", "optionsLang": "en", "options": ["10:45", "11:15", "11:45"], "answer": 0, "vocab": ["son-las", "menos-cuarto"] },
    { "id": "c2-11", "type": "listen-choose", "prompt": "Which 24-hour time?", "audio": "a las nueve y media de la noche", "optionsLang": "en", "options": ["21:30", "09:30", "19:30"], "answer": 0, "vocab": ["y-media", "de-la-noche"] },
    { "id": "c2-12", "type": "listen-choose", "prompt": "Is the shop open now, at 15:00?", "audio": "Abierto de diez a dos y de cinco a ocho.", "optionsLang": "en", "options": ["No, it's closed until 17:00", "Yes, until 20:00", "Yes, it never closes"], "answer": 0, "vocab": ["abierto"] },
    { "id": "c2-13", "type": "fill-blank", "prompt": "estar.", "es": "El hotel {{está}} cerca de la plaza.", "en": "The hotel is near the square.", "options": ["está", "es", "hay"], "vocab": ["esta", "hotel", "cerca", "plaza"] },
    { "id": "c2-14", "type": "match-pairs", "prompt": "Places.", "pairs": [["la farmacia", "pharmacy"], ["el aeropuerto", "airport"], ["el supermercado", "supermarket"], ["la catedral", "cathedral"], ["el cajero", "cash machine"], ["la entrada", "entrance; ticket"]], "vocab": ["farmacia", "aeropuerto", "supermercado", "catedral", "cajero", "entrada"] },
    { "id": "c2-15", "type": "fill-blank", "prompt": "ir.", "es": "Mañana {{vamos}} a la catedral.", "en": "Tomorrow we're going to the cathedral.", "options": ["vamos", "vais", "van"], "vocab": ["vamos", "catedral", "manana"] },
    { "id": "c2-16", "type": "listen-choose", "prompt": "What does he want?", "audio": "Quería unos guantes negros, talla grande.", "optionsLang": "en", "options": ["Black gloves, large", "Black gloves, small", "A black hat, large"], "answer": 0, "vocab": ["guantes", "negro", "talla", "grande"] },
    { "id": "c2-17", "type": "fill-blank", "prompt": "Colours agree.", "es": "Unas camisetas {{blancas}}.", "en": "Some white T-shirts.", "options": ["blancas", "blancos", "blanca"], "vocab": ["camiseta", "blanco", "unos-unas"] },
    { "id": "c2-18", "type": "listen-choose", "prompt": "What's the weather like?", "audio": "Llueve y hace mucho viento.", "optionsLang": "en", "options": ["Rainy and very windy", "Snowing and windy", "Cloudy and cold"], "answer": 0, "vocab": ["llueve", "hace-viento"] },
    { "id": "c2-19", "type": "fill-blank", "prompt": "gustar.", "es": "¿Te {{gusta}} el cocido madrileño?", "en": "Do you like cocido madrileño?", "options": ["gusta", "gustan", "gustas"], "vocab": ["te-gusta-q", "cocido"] },
    { "id": "c2-20", "type": "fill-blank", "prompt": "poder or necesitar?", "es": "{{Necesito}} un paraguas. Llueve.", "en": "I need an umbrella. It's raining.", "options": ["Necesito", "Puedo"], "vocab": ["necesito", "paraguas", "llueve"] },
    { "id": "c2-21", "type": "listen-choose", "prompt": "What hurts?", "audio": "Me duele la mano.", "optionsLang": "en", "options": ["Her hand", "Her foot", "Her head"], "answer": 0, "vocab": ["me-duele", "mano"] },
    { "id": "c2-22", "type": "fill-blank", "prompt": "-ar verbs.", "es": "Mis amigos {{trabajan}} en Madrid.", "en": "My friends work in Madrid.", "options": ["trabajan", "trabaja", "trabajamos"], "vocab": ["trabajar", "amigo"] },
    { "id": "c2-23", "type": "fill-blank", "prompt": "Question words.", "es": "¿{{Cuándo}} abre la taquilla?", "en": "When does the ticket office open?", "options": ["Cuándo", "Cuánto", "Cuál"], "vocab": ["cuando", "abre", "taquilla"] },
    { "id": "c2-24", "type": "dictation", "es": "la bufanda", "hint": "scarf", "vocab": ["bufanda"] },
    { "id": "c2-25", "type": "dictation", "es": "¿Cuánto cuesta?", "hint": "How much is it?", "vocab": ["cuesta"] },
    { "id": "c2-26", "type": "build-sentence", "es": "¿Hay una farmacia cerca del hotel?", "en": "Is there a pharmacy near the hotel?", "distractors": ["está", "lejos"], "vocab": ["hay-q", "farmacia", "cerca", "hotel"] },
    { "id": "c2-27", "type": "build-sentence", "direction": "audio-to-es", "es": "Tengo veintinueve años y soy de Estados Unidos.", "en": "I'm twenty-nine and I'm from the United States.", "distractors": ["estoy"], "vocab": ["cuantos-anos", "soy-de"] },
    { "id": "c2-28", "type": "repeat", "es": "Perdón, ¿a qué hora cierra el museo?", "en": "Excuse me, what time does the museum close?", "vocab": ["perdon", "a-que-hora", "cierra", "museo"] },
    { "id": "c2-29", "type": "repeat", "es": "Hace frío. ¿Tomamos un chocolate con churros?", "en": "It's cold. Shall we have hot chocolate with churros?", "vocab": ["hace-frio", "tomar", "chocolate", "churros"] },
    { "id": "c2-30", "type": "shadow", "es": "¿Dónde está la parada de metro? Está allí, no está lejos.", "en": "Where is the metro stop? It's over there, it isn't far.", "listenFor": "Stress on the last syllable of está every time, ll in allí, and the throaty j in lejos.", "vocab": ["donde-esta", "parada", "metro", "alli", "lejos"] }
  ]
}
