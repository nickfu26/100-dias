{
  "$schema": "./schema.json",
  "day": 20,
  "level": 2,
  "title": { "en": "Days and dates", "es": "Los días y las fechas" },
  "objectives": [
    "Name the seven days of the week",
    "Recognise the months, and say enero and diciembre",
    "Say a date: el trece de enero",
    "Talk about the week, the weekend and yesterday"
  ],
  "teach": [
    {
      "kind": "note",
      "md": "**The week starts on Monday** in Spain, and days are written in **lowercase**:\n\n- **lunes** (Mon), **martes** (Tue), **miércoles** (Wed), **jueves** (Thu), **viernes** (Fri)\n- **sábado** (Sat), **domingo** (Sun)\n\nAll of them are masculine: *el lunes*."
    },
    { "kind": "phrase", "es": "Hoy es martes.", "en": "Today is Tuesday.", "note": "No article after es: Hoy es martes, not Hoy es el martes." },
    {
      "kind": "note",
      "md": "**el** with a day means *on*: **el lunes** = on Monday (this one). **los lunes** = on Mondays (every week).\n\nDays ending in -s don't change in the plural: *el martes*, *los martes*."
    },
    { "kind": "phrase", "es": "el fin de semana", "en": "the weekend", "note": "Literally 'the end of the week'. Many shops in Madrid close on Sunday, but most bars and restaurants stay open." },
    {
      "kind": "note",
      "md": "**The months**, also lowercase: enero, febrero, marzo, abril, mayo, junio, julio, agosto, septiembre, octubre, noviembre, diciembre.\n\nFor now, learn the two you'll actually need: **diciembre** (the end of this course) and **enero** (the trip)."
    },
    { "kind": "phrase", "es": "el miércoles trece de enero", "en": "Wednesday 13 January", "note": "Your arrival day. A date is el + number + de + month. Day first, as in the UK: 13/1/2027." },
    { "kind": "phrase", "es": "ayer, hoy, mañana", "en": "yesterday, today, tomorrow", "note": "You already know hoy and mañana. Ayer completes the set." }
  ],
  "vocab": [
