    { "id": "d057-03", "type": "listen-choose", "audio": "la farmacia de guardia", "options": ["la farmacia de guardia", "el guardarropa", "la farmacia de Sol"], "answer": 0, "vocab": ["farmacia-de-guardia"] },
    { "id": "d057-04", "type": "match-pairs", "pairs": [["¿Tiene algo para…?", "Do you have something for…?"], ["el dolor de cabeza", "headache"], ["la tos", "cough"], ["el resfriado", "cold"], ["sin receta", "without a prescription"], ["¿Cuántas veces al día?", "How many times a day?"]], "vocab": ["tiene-algo-para", "dolor-de-cabeza", "tos", "resfriado", "sin-receta", "cuantas-veces-al-dia"] },
    { "id": "d057-05", "type": "fill-blank", "es": "¿Tiene algo {{para}} el dolor de cabeza?", "en": "Do you have something for a headache?", "options": ["para", "por", "de"], "vocab": ["tiene-algo-para", "dolor-de-cabeza"] },
