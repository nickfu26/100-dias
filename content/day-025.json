    { "id": "d025-10", "type": "fill-blank", "es": "La {{taquilla}} abre a las nueve.", "en": "The ticket office opens at nine.", "options": ["taquilla", "salida", "tienda"], "vocab": ["taquilla", "abre"] },
    { "id": "d025-11", "type": "listen-choose", "prompt": "Where is the market?", "audio": "El mercado está cerca de la plaza.", "optionsLang": "en", "options": ["Near the square", "Near the station", "Far from the square"], "answer": 0, "vocab": ["mercado", "cerca", "plaza"] },
    { "id": "d025-12", "type": "listen-choose", "prompt": "What does she want?", "audio": "Tres entradas, por favor.", "optionsLang": "en", "options": ["Three tickets", "Three exits", "Three stops"], "answer": 0, "vocab": ["entrada", "tres"] },
    { "id": "d025-13", "type": "listen-choose", "prompt": "When is the train?", "audio": "El tren es a las veintitrés quince.", "optionsLang": "en", "options": ["23:15", "13:15", "23:50"], "answer": 0, "vocab": ["tren", "hora-24", "veintitres"] },
    { "id": "d025-14", "type": "listen-choose", "prompt": "Where is the metro?", "audio": "El metro está allí, a la salida de la estación.", "optionsLang": "en", "options": ["Over there, at the station exit", "Far from the station", "Inside the market"], "answer": 0, "vocab": ["metro", "alli", "salida", "estacion"] },
    { "id": "d025-15", "type": "dictation", "es": "el metro", "hint": "underground", "vocab": ["metro"] },
    { "id": "d025-16", "type": "dictation", "es": "la entrada", "hint": "way in; museum ticket", "vocab": ["entrada"] },
    { "id": "d025-17", "type": "dictation", "es": "la taquilla", "hint": "ticket office (qu + ll)", "vocab": ["taquilla"] },
    { "id": "d025-18", "type": "build-sentence", "es": "¿Dónde está la parada de metro?", "en": "Where is the metro stop?", "distractors": ["hay", "tren"], "vocab": ["donde-esta", "parada", "metro"] },
    { "id": "d025-19", "type": "build-sentence", "es": "La salida está allí, cerca de la taquilla.", "en": "The exit is over there, near the ticket office.", "distractors": ["entrada", "lejos"], "vocab": ["salida", "alli", "cerca", "taquilla"] },
    { "id": "d025-20", "type": "build-sentence", "direction": "audio-to-es", "es": "Quería dos entradas, por favor.", "en": "I'd like two tickets, please.", "distractors": ["quiere", "salidas"], "vocab": ["queria", "entrada", "dos"] },
