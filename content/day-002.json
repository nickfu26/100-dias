    { "id": "d002-02", "type": "listen-choose", "prompt": "Where is the stress? Pick the word you hear.", "audio": "papa", "options": ["papa", "papá"], "answer": 0, "vocab": [] },
    { "id": "d002-03", "type": "listen-choose", "prompt": "Which syllable is stressed?", "audio": "el autobús", "optionsLang": "en", "options": ["AU-to-bus", "au-TO-bus", "au-to-BUS"], "answer": 2, "vocab": ["autobus"] },
    { "id": "d002-04", "type": "listen-choose", "prompt": "Which syllable is stressed?", "audio": "el móvil", "optionsLang": "en", "options": ["MO-vil", "mo-VIL"], "answer": 0, "vocab": ["movil"] },
    { "id": "d002-05", "type": "listen-choose", "prompt": "Which syllable is stressed?", "audio": "gracias", "optionsLang": "en", "options": ["GRA-cias", "gra-CIAS"], "answer": 0, "vocab": ["gracias"] },
    { "id": "d002-06", "type": "listen-choose", "prompt": "Which syllable is stressed?", "audio": "el menú", "optionsLang": "en", "options": ["ME-nu", "me-NU"], "answer": 1, "vocab": ["menu"] },
    { "id": "d002-07", "type": "match-pairs", "pairs": [["¿Qué tal?", "How's it going?"], ["muy", "very"], ["bien", "well"], ["vale", "OK"], ["gracias", "thank you"]], "vocab": ["que-tal", "muy", "bien", "vale", "gracias"] },
    { "id": "d002-08", "type": "match-pairs", "pairs": [["el café", "the coffee"], ["el menú", "the menu"], ["el autobús", "the bus"], ["el móvil", "the mobile phone"], ["y", "and"]], "vocab": ["cafe", "menu", "autobus", "movil", "y-and"] },
    { "id": "d002-09", "type": "fill-blank", "prompt": "Yes or if? Pick the right spelling.", "es": "{{Sí}}, gracias.", "en": "Yes, thank you.", "options": ["Sí", "Si"], "vocab": ["si-yes", "gracias"] },
    { "id": "d002-10", "type": "fill-blank", "prompt": "Tea or you? Pick the right spelling.", "es": "Un café y un {{té}}.", "en": "A coffee and a tea.", "options": ["té", "te"], "vocab": ["cafe", "y-and"] },
    { "id": "d002-11", "type": "fill-blank", "es": "Muy {{bien}}, ¿y tú?", "en": "Very well, and you?", "options": ["bien", "vale", "muy"], "vocab": ["muy", "bien", "y-and", "tu-you"] },
    { "id": "d002-12", "type": "build-sentence", "es": "Hola, ¿qué tal?", "en": "Hi, how's it going?", "distractors": ["adiós"], "vocab": ["hola", "que-tal"] },
    { "id": "d002-13", "type": "build-sentence", "es": "Muy bien, ¿y tú?", "en": "Very well, and you?", "distractors": ["vale"], "vocab": ["muy", "bien", "y-and", "tu-you"] },
    { "id": "d002-14", "type": "dictation", "es": "café", "hint": "coffee (remember the accent)", "vocab": ["cafe"] },
    { "id": "d002-15", "type": "dictation", "es": "vale", "hint": "OK (the v sounds like b)", "vocab": ["vale"] },
    { "id": "d002-16", "type": "repeat", "es": "Hola, ¿qué tal?", "en": "Hi, how's it going?", "vocab": ["hola", "que-tal"] },
    { "id": "d002-17", "type": "repeat", "es": "Vale, gracias.", "en": "OK, thanks.", "vocab": ["vale", "gracias"] },
    { "id": "d002-18", "type": "shadow", "es": "papa, papá", "en": "Pope, dad", "listenFor": "Move the stress: PA-pa, then pa-PÁ.", "vocab": [] },
    { "id": "d002-19", "type": "shadow", "es": "el café, el menú, el autobús", "en": "the coffee, the menu, the bus", "listenFor": "Hit the last syllable each time: ca-FÉ, me-NÚ, au-to-BÚS.", "vocab": ["cafe", "menu", "autobus"] },
    { "id": "d002-20", "type": "listen-choose", "prompt": "Review: what does it mean?", "audio": "adiós", "optionsLang": "en", "options": ["goodbye", "yes", "hello"], "answer": 0, "vocab": ["adios"] },
    { "id": "d002-21", "type": "dictation", "prompt": "Review: type what you hear.", "es": "la casa", "hint": "the house", "vocab": ["casa"] },
    { "id": "d002-22", "type": "fill-blank", "prompt": "Review: complete the greeting.", "es": "Hola, {{buenos}} días.", "en": "Hello, good morning.", "options": ["buenos", "muy", "uno"], "vocab": ["hola", "buenos-dias"] }
  ]
}
