    { "id": "d047-10", "type": "listen-choose", "prompt": "What's the first price?", "audio": "¿Esto? Quince euros.", "optionsLang": "en", "options": ["€15", "€50", "€5"], "answer": 0, "vocab": ["esto", "quince", "euro"] },
    { "id": "d047-11", "type": "listen-choose", "prompt": "Does the seller accept eight?", "audio": "¿Ocho? No, no. ¿Diez?", "optionsLang": "en", "options": ["No, he offers ten", "Yes, eight is fine", "No, he wants fifteen"], "answer": 0, "vocab": ["ocho", "diez"] },
