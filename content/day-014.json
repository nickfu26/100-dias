    { "id": "d014-03", "type": "listen-choose", "audio": "el bocadillo", "options": ["el bocadillo", "el cortado", "el pan"], "answer": 0, "vocab": ["bocadillo"] },
    { "id": "d014-04", "type": "match-pairs", "pairs": [["la tapa", "small plate"], ["la ración", "plate to share"], ["el pan", "bread"], ["las aceitunas", "olives"], ["el bocadillo", "baguette sandwich"]], "vocab": ["tapa", "racion", "pan", "aceitunas", "bocadillo"] },
    { "id": "d014-05", "type": "match-pairs", "pairs": [["las patatas bravas", "spicy fried potatoes"], ["la tortilla", "potato omelette"], ["las croquetas", "croquettes"], ["los calamares", "fried squid"]], "vocab": ["patatas-bravas", "tortilla", "croquetas", "calamares"] },
    { "id": "d014-06", "type": "fill-blank", "es": "Unas croquetas {{de}} jamón, por favor.", "en": "Some ham croquettes, please.", "options": ["de", "con", "y"], "vocab": ["croquetas", "jamon"] },
